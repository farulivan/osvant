---
// PDP × 5 (03-page-specs.md §3) — data-scent theming (01 §2.3: ONE
// attribute swap, nothing else recolored manually). Sections: 3.1 scent
// hero, 3.2 note pyramid (M §4.6), 3.3 formula story, 3.4 cross-sell.
// Bottle: the light study (M §8, ADR-013) with drag-to-light
// per M §4.4b — the hero is laid out to fit one viewport at ≥725px so
// product, price and add-to-cart are all reachable without scrolling
// (03 §3.1 acceptance, review OSV-05).
import BaseLayout from "../../layouts/BaseLayout.astro";
import LightStudy from "../../components/LightStudy.astro";
import FormulaStory from "../../components/FormulaStory.astro";
import { stillFor } from "../../lib/stills";
import { withBase } from "../../lib/url";
import {
  absoluteUrl,
  buildProductJsonLd,
  jsonLdScript,
  OG_DEFAULT_PATH,
  pdpTitle,
} from "../../lib/seo";
import { catalog as products, summaryNotes } from "../../lib/commerce";
import { Image } from "astro:assets";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { scent: product.scent },
    props: { product },
  }));
}

const { product } = Astro.props;
const others = products.filter((p) => p.scent !== product.scent);
const [article, ...rest] = product.name.split(" ");
const available = product.variants.filter((v) => v.availableForSale);
const soldOut = available.length === 0;
const limited = product.variants.some((v) => v.limited);
// Product structured data (RFC-001 C4, approved with B2 data). The image
// is the OG house placeholder until per-scent bottle stills land (06 §1).
const pdpUrl = absoluteUrl(Astro.url.pathname, Astro.site);
const jsonLd = jsonLdScript(
  buildProductJsonLd(
    product,
    pdpUrl,
    absoluteUrl(withBase(OG_DEFAULT_PATH), Astro.site),
  ),
);
// 03 §3.2 eyebrows are LAW; the notes come from the pyramid's own tiers.
const rows = [
  { label: "top — the spark", notes: product.notes.top },
  { label: "heart — the current", notes: product.notes.heart },
  { label: "base — the ground", notes: product.notes.base },
];
---

<BaseLayout
  title={pdpTitle(product.name)}
  description={`${product.name} — ${product.character}`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <div
    data-scent={product.scent}
    data-pdp
    data-default-sku={product.variants[0].sku}
  >
    {/* 3.1 scent hero */}
    <section
      class="grid min-h-svh grid-cols-2 items-center gap-5 bg-black px-gutter pt-[calc(var(--nav-height)+3rem)] pb-12 max-md:min-h-0 max-md:grid-cols-1 max-md:items-start max-md:pb-32"
      data-nav-theme="scent"
    >
      <div class="flex flex-col gap-10 max-md:order-2">
        <div>
          <p class="mb-4 eyebrow text-xs" data-eyebrow>
            batch {product.batch} — eau de parfum
          </p>
          <h1
            class="display text-impact [&_em]:text-scent-tint-text [&_em]:not-italic"
          >
            <em>{article}</em>{" "}
            {rest.join(" ")}
          </h1>
          <p class="mt-6 max-w-[28ch] text-2xl">{product.character}</p>
        </div>

        {
          /* 3.1 purchase row — inline in the hero's left column at desktop,
          fixed bottom bar ≤767px (03 §3.1). Its own grid area so the
          mobile bar can detach without reflowing the column. */
        }
        <div
          class="flex flex-wrap items-center gap-x-6 gap-y-4 max-md:fixed max-md:inset-x-0 max-md:bottom-0 max-md:z-20 max-md:gap-3 max-md:border-t max-md:border-t-ink-3 max-md:bg-ink-1 max-md:px-gutter max-md:py-4 [&_.btn-primary]:ml-auto max-md:[&_.btn-primary]:ml-0 max-md:[&_.btn-primary]:flex-1 [&_.btn-primary:disabled]:cursor-not-allowed [&_.btn-primary:disabled]:bg-ink-3 [&_.btn-primary:disabled]:text-haze-3"
        >
          {
            /* One size is not a choice. Rendering it as a lone chip offers
              a control that cannot be operated, and next to the `limited`
              badge the two were indistinguishable (review OSV-26). */
            product.variants.length === 1 ? (
              <p class="flex items-center gap-2 text-base text-haze-2">
                <span>{product.variants[0].size}</span>
                {limited && (
                  <>
                    <span class="text-ink-4" aria-hidden="true">
                      ·
                    </span>
                    <span class="rounded-sm bg-[color-mix(in_oklab,var(--color--amber)_16%,transparent)] px-3 py-1.5 eyebrow text-xs text-amber">
                      limited
                    </span>
                  </>
                )}
              </p>
            ) : (
              <div
                class="flex items-center gap-2"
                role="group"
                aria-label="size"
              >
                {product.variants.map((variant, i) => (
                  <button
                    class="cursor-pointer rounded-sm border border-ink-4 bg-transparent px-4 py-2 text-base text-white aria-pressed:border-scent-tint aria-pressed:bg-[color-mix(in_oklab,var(--scent-tint)_18%,transparent)]"
                    type="button"
                    data-size-chip
                    data-sku={variant.sku}
                    data-price={`€${variant.price}`}
                    aria-pressed={i === 0}
                    {...(i === 0 ? { "data-selected": true } : {})}
                  >
                    {variant.size}
                  </button>
                ))}
                {limited && (
                  <span class="rounded-sm bg-[color-mix(in_oklab,var(--color--amber)_16%,transparent)] px-3 py-1.5 eyebrow text-xs text-amber">
                    limited
                  </span>
                )}
              </div>
            )
          }

          <p class="text-xl" data-price>
            €{available[0]?.price ?? product.variants[0].price}
          </p>

          {
            soldOut ? (
              <>
                {/* B3 sold-out: disabled primary + get-notified line input */}
                <button class="btn-primary" type="button" disabled>
                  <span data-btn-label>sold out — next batch soon</span>
                </button>
                <form
                  class="ml-auto flex gap-3 [&_input]:rounded-none [&_input]:border-0 [&_input]:border-b [&_input]:border-b-ink-4 [&_input]:bg-transparent [&_input]:py-2 [&_input]:text-lg [&_input]:text-white [&_input:focus-visible]:border-b-phosphor"
                  data-notify-form
                >
                  <label class="sr-only" for={`notify-${product.scent}`}>
                    Email
                  </label>
                  <input
                    id={`notify-${product.scent}`}
                    type="email"
                    name="email"
                    placeholder="your email"
                    required
                  />
                  <button
                    class="cursor-pointer border-0 bg-none text-base text-white"
                    type="submit"
                  >
                    get notified
                  </button>
                </form>
                <p class="ml-auto text-xl" data-notify-done hidden>
                  you're in the current.
                </p>
              </>
            ) : (
              <button class="btn-primary" type="button" data-add-to-cart>
                <span data-btn-label>add to cart</span>
              </button>
            )
          }
        </div>
      </div>

      {
        /* 03 §3.1 — the bottle as a light study (M §8). Drag moves the
          light, not the object (M §4.4b); modules/pdp-bottle.ts wires the
          pointer and keyboard controls to this stage. */
      }
      <div
        class="w-full max-w-[min(72vh,40rem)] cursor-grab touch-pan-y place-self-center active:cursor-grabbing max-md:order-1"
        data-pdp-bottle
        tabindex="0"
        role="slider"
        aria-label={`lighting on the ${product.name} bottle`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="centred"
      >
        <LightStudy
          scent={product.scent}
          alt={`${product.name} bottle`}
          image={stillFor(product.scent)}
          width={900}
          eager
        />
      </div>
    </section>

    {/* 3.2 note pyramid (M §4.6) */}
    <section
      class="bg-black px-gutter py-24"
      data-pyramid
      data-nav-theme="scent"
      aria-label="note pyramid"
    >
      {
        rows.map((row) => (
          <div class="relative py-10" data-pyramid-row>
            <p class="mb-4 eyebrow text-xs">{row.label}</p>
            <p class="display text-3xl" data-pyramid-notes>
              {row.notes.join(" · ")}
            </p>
            <span
              class="mt-10 block h-px origin-left bg-ink-3"
              data-pyramid-divider
              aria-hidden="true"
            />
          </div>
        ))
      }
    </section>

    {/* 3.3 formula story — alternating parallax rows + one pull-quote */}
    <FormulaStory product={product} />

    {/* 3.4 cross-sell — native overflow-x + scroll-snap (no hijacking) */}
    <section
      class="bg-black px-gutter pt-16 pb-24"
      data-nav-theme="dark"
      aria-labelledby="xsell-title"
    >
      <h2 class="mb-8 display text-3xl" id="xsell-title">
        also in the current
      </h2>
      <ul
        class="m-0 flex snap-x snap-mandatory list-none gap-5 overflow-x-auto p-0"
      >
        {
          others.map((other) => (
            <li class="flex-none basis-64 snap-start">
              <a
                class="flex flex-col gap-2 rounded-sm border border-transparent bg-ink-2 p-5 text-white no-underline motion-safe:[transition:border-color_0.3s] motion-safe:hover:border-scent-tint motion-safe:focus-visible:border-scent-tint"
                href={withBase(`collection/${other.scent}/`)}
                data-scent={other.scent}
              >
                <Image
                  class="mb-1 aspect-square w-full rounded-sm bg-[radial-gradient(circle_at_50%_55%,color-mix(in_oklab,var(--scent-tint)_22%,transparent),transparent_70%)] object-contain"
                  src={stillFor(other.scent)}
                  alt=""
                  width={320}
                  widths={[220, 320]}
                  sizes="16rem"
                  format="avif"
                  quality={55}
                  loading="lazy"
                  decoding="async"
                />
                <span class="eyebrow text-xs">
                  {summaryNotes(other).join(" · ")}
                </span>
                <span class="display text-xl">{other.name}</span>
                <span class="eyebrow text-xs">€{other.variants[0].price}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
