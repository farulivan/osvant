---
// PDP stub × 5 (03-page-specs.md §3). Catalog from `lib/commerce.ts`
// (07 §1.1) — real PDP content lands in M2.
import BaseLayout from "../../layouts/BaseLayout.astro";
import StubSection from "../../components/StubSection.astro";
import { getProducts } from "../../lib/commerce";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { scent: product.scent } }));
}

const { scent } = Astro.params;
---

<BaseLayout title={scent} description={`the ${scent} — osvant eau de parfum.`}>
  <div data-scent={scent}>
    <StubSection
      eyebrow={`batch — eau de parfum`}
      title={scent}
      theme="scent"
    />
  </div>
</BaseLayout>
