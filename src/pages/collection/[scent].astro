---
// PDP × 5 (03-page-specs.md §3) — data-scent theming (01 §2.3: ONE
// attribute swap, nothing else recolored manually). Sections: 3.1 scent
// hero, 3.2 note pyramid (M §4.6), 3.3 formula story, 3.4 cross-sell.
// Bottle: the light study (M §8, ADR-013) with drag-to-light
// per M §4.4b — the hero is laid out to fit one viewport at ≥725px so
// product, price and add-to-cart are all reachable without scrolling
// (03 §3.1 acceptance, review OSV-05).
import BaseLayout from "../../layouts/BaseLayout.astro";
import LightStudy from "../../components/LightStudy.astro";
import FormulaStory from "../../components/FormulaStory.astro";
import { stillFor } from "../../lib/stills";
import { withBase } from "../../lib/url";
import {
  absoluteUrl,
  buildProductJsonLd,
  jsonLdScript,
  OG_DEFAULT_PATH,
  pdpTitle,
} from "../../lib/seo";
import { catalog as products, summaryNotes } from "../../lib/commerce";
import { Image } from "astro:assets";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { scent: product.scent },
    props: { product },
  }));
}

const { product } = Astro.props;
const others = products.filter((p) => p.scent !== product.scent);
const [article, ...rest] = product.name.split(" ");
const available = product.variants.filter((v) => v.availableForSale);
const soldOut = available.length === 0;
const limited = product.variants.some((v) => v.limited);
// Product structured data (RFC-001 C4, approved with B2 data). The image
// is the OG house placeholder until per-scent bottle stills land (06 §1).
const pdpUrl = absoluteUrl(Astro.url.pathname, Astro.site);
const jsonLd = jsonLdScript(
  buildProductJsonLd(
    product,
    pdpUrl,
    absoluteUrl(withBase(OG_DEFAULT_PATH), Astro.site),
  ),
);
// 03 §3.2 eyebrows are LAW; the notes come from the pyramid's own tiers.
const rows = [
  { label: "top — the spark", notes: product.notes.top },
  { label: "heart — the current", notes: product.notes.heart },
  { label: "base — the ground", notes: product.notes.base },
];
---

<BaseLayout
  title={pdpTitle(product.name)}
  description={`${product.name} — ${product.character}`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd} />
  <div
    data-scent={product.scent}
    data-pdp
    data-default-sku={product.variants[0].sku}
  >
    {/* 3.1 scent hero */}
    <section class="pdp-hero" data-nav-theme="scent">
      <div class="pdp-hero__column">
        <div class="pdp-hero__info">
          <p class="pdp-hero__eyebrow" data-eyebrow>
            batch {product.batch} — eau de parfum
          </p>
          <h1 class="pdp-hero__name">
            <em>{article}</em>{" "}
            {rest.join(" ")}
          </h1>
          <p class="pdp-hero__character">{product.character}</p>
        </div>

        {
          /* 3.1 purchase row — inline in the hero's left column at desktop,
          fixed bottom bar ≤767px (03 §3.1). Its own grid area so the
          mobile bar can detach without reflowing the column. */
        }
        <div class="pdp-buy">
          {
            /* One size is not a choice. Rendering it as a lone chip offers
              a control that cannot be operated, and next to the `limited`
              badge the two were indistinguishable (review OSV-26). */
            product.variants.length === 1 ? (
              <p class="pdp-buy__spec">
                <span>{product.variants[0].size}</span>
                {limited && (
                  <>
                    <span class="pdp-buy__spec-sep" aria-hidden="true">
                      ·
                    </span>
                    <span class="pdp-buy__badge">limited</span>
                  </>
                )}
              </p>
            ) : (
              <div class="pdp-buy__chips" role="group" aria-label="size">
                {product.variants.map((variant, i) => (
                  <button
                    class="pdp-buy__chip"
                    type="button"
                    data-size-chip
                    data-sku={variant.sku}
                    data-price={`€${variant.price}`}
                    aria-pressed={i === 0}
                    {...(i === 0 ? { "data-selected": true } : {})}
                  >
                    {variant.size}
                  </button>
                ))}
                {limited && <span class="pdp-buy__badge">limited</span>}
              </div>
            )
          }

          <p class="pdp-buy__price" data-price>
            €{available[0]?.price ?? product.variants[0].price}
          </p>

          {
            soldOut ? (
              <>
                {/* B3 sold-out: disabled primary + get-notified line input */}
                <button class="btn-primary" type="button" disabled>
                  <span data-btn-label>sold out — next batch soon</span>
                </button>
                <form class="pdp-buy__notify" data-notify-form>
                  <label
                    class="visually-hidden"
                    for={`notify-${product.scent}`}
                  >
                    Email
                  </label>
                  <input
                    id={`notify-${product.scent}`}
                    type="email"
                    name="email"
                    placeholder="your email"
                    required
                  />
                  <button class="pdp-buy__notify-btn" type="submit">
                    get notified
                  </button>
                </form>
                <p class="pdp-buy__notify-done" data-notify-done hidden>
                  you're in the current.
                </p>
              </>
            ) : (
              <button class="btn-primary" type="button" data-add-to-cart>
                <span data-btn-label>add to cart</span>
              </button>
            )
          }
        </div>
      </div>

      {
        /* 03 §3.1 — the bottle as a light study (M §8). Drag moves the
          light, not the object (M §4.4b); modules/pdp-bottle.ts wires the
          pointer and keyboard controls to this stage. */
      }
      <div
        class="pdp-hero__bottle"
        data-pdp-bottle
        tabindex="0"
        role="slider"
        aria-label={`lighting on the ${product.name} bottle`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="centred"
      >
        <LightStudy
          scent={product.scent}
          alt={`${product.name} bottle`}
          image={stillFor(product.scent)}
          width={900}
          eager
        />
      </div>
    </section>

    {/* 3.2 note pyramid (M §4.6) */}
    <section
      class="pyramid"
      data-pyramid
      data-nav-theme="scent"
      aria-label="note pyramid"
    >
      {
        rows.map((row) => (
          <div class="pyramid__row" data-pyramid-row>
            <p class="pyramid__eyebrow">{row.label}</p>
            <p class="pyramid__notes" data-pyramid-notes>
              {row.notes.join(" · ")}
            </p>
            <span
              class="pyramid__divider"
              data-pyramid-divider
              aria-hidden="true"
            />
          </div>
        ))
      }
    </section>

    {/* 3.3 formula story — alternating parallax rows + one pull-quote */}
    <FormulaStory product={product} />

    {/* 3.4 cross-sell — native overflow-x + scroll-snap (no hijacking) */}
    <section class="xsell" data-nav-theme="dark" aria-labelledby="xsell-title">
      <h2 class="xsell__title" id="xsell-title">also in the current</h2>
      <ul class="xsell__rail">
        {
          others.map((other) => (
            <li class="xsell__item">
              <a
                class="xsell__card"
                href={withBase(`collection/${other.scent}/`)}
                data-scent={other.scent}
              >
                <Image
                  class="xsell__still"
                  src={stillFor(other.scent)}
                  alt=""
                  width={320}
                  widths={[220, 320]}
                  sizes="16rem"
                  format="avif"
                  quality={55}
                  loading="lazy"
                  decoding="async"
                />
                <span class="xsell__notes">
                  {summaryNotes(other).join(" · ")}
                </span>
                <span class="xsell__name">{other.name}</span>
                <span class="xsell__price">€{other.variants[0].price}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 03 §3.1 — the hero has to FIT one viewport: product, price and
     add-to-cart all reachable without scrolling. It previously ran to
     149vh with `align-items: center`, which centred the content out of
     view and pushed the bottle 291px below the fold (review OSV-05).
     Rows are sized to content and the whole grid is centred as a block,
     so the column can never grow taller than the section. */
  .pdp-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "column bottle";
    align-items: center;
    gap: var(--grid-gap);
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--nav-height) + 3rem) var(--gutter) 3rem;
    background: var(--color--black);
  }

  /* Name block and buy row travel together — the bottle spans the full
     hero height, so any slack has to land outside this column rather
     than opening a void between the character line and the CTA. */
  .pdp-hero__column {
    grid-area: column;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .pdp-hero__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .pdp-hero__name {
    margin: 0;
    font-size: var(--text--impact);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1.05;
  }

  .pdp-hero__name em {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
  }

  .pdp-hero__character {
    margin: var(--space--headline-lede) 0 0;
    font-size: var(--text--lead);
    max-width: 28ch;
  }

  /* Bottle stage (03 §3.1) — the light study mounts here (M §8).
     Capped so the hero always clears one viewport. */
  .pdp-hero__bottle {
    grid-area: bottle;
    place-self: center center;
    width: 100%;
    max-width: min(72vh, 40rem);

    /* Horizontal drags move the light; vertical scroll stays native
       (M §4.4b). */
    touch-action: pan-y;
    cursor: grab;
  }

  .pdp-hero__bottle:active {
    cursor: grabbing;
  }

  /* Purchase row — inline in the hero at desktop (03 §3.1) */
  .pdp-buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .pdp-buy__chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pdp-buy__chip {
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--color--ink-4);
    border-radius: var(--radius--xs);
    color: var(--color--white);
    font-size: var(--text--btn);
    cursor: pointer;
  }

  /* Selected reads as filled, not merely re-bordered. A border-colour
     swap alone is a weak selected state next to an unselected sibling
     that also has a border. */
  .pdp-buy__chip[aria-pressed="true"] {
    border-color: var(--scent-tint);
    background: color-mix(in oklab, var(--scent-tint) 18%, transparent);
    color: var(--color--white);
  }

  /* Form encodes function (review OSV-26). A CONTROL carries a border and
     gains a fill when selected; a BADGE is a tinted field with no border,
     because a border is what the eye reads as "you can press this". The
     size chip and the limited badge previously shared both, sat adjacent
     on the fever PDP, and were indistinguishable.

     Amber canonical role: scarcity signal (01 §1 rule 4). */
  .pdp-buy__badge {
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius--xs);
    background: color-mix(in oklab, var(--color--amber) 16%, transparent);
    color: var(--color--amber);
    font-size: var(--text--eyebrow);
    letter-spacing: 0.12em;
  }

  /* One size is a fact about the product, so it is set as one. */
  .pdp-buy__spec {
    display: flex;
    align-items: center;
    gap: var(--space--2xs);
    margin: 0;
    font-size: var(--text--btn);
    color: var(--color--lilac-2);
  }

  .pdp-buy__spec-sep {
    color: var(--color--ink-4);
  }

  .pdp-buy__price {
    margin: 0;
    font-size: var(--text--h5);
  }

  .pdp-buy .btn-primary {
    margin-left: auto;
  }

  /* ≤767px the buy row detaches into the fixed bottom bar the spec asks
     for — below the nav (100), above page content. */
  @media (width <= 47.9375rem) {
    .pdp-hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "bottle"
        "column";
      align-items: start;
      padding-bottom: 8rem;
    }

    .pdp-buy {
      position: fixed;
      inset: auto 0 0;
      z-index: 90;
      gap: 0.75rem 1rem;
      padding: 1rem var(--gutter);
      background: var(--color--ink-1);
      border-top: 1px solid var(--color--ink-3);
    }
  }

  .pdp-buy .btn-primary:disabled {
    background: var(--color--ink-3);
    color: var(--color--lilac-3);
    cursor: not-allowed;
  }

  .pdp-buy__notify {
    display: flex;
    gap: 0.75rem;
    margin-left: auto;
  }

  .pdp-buy__notify input {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color--ink-4);
    border-radius: 0;
    color: var(--color--white);
    padding: 0.5rem 0;
    font-size: var(--text--body);
  }

  .pdp-buy__notify input:focus-visible {
    border-bottom-color: var(--color--uv);
  }

  .pdp-buy__notify-btn {
    background: none;
    border: 0;
    color: var(--color--white);
    font-size: var(--text--btn);
    cursor: pointer;
  }

  .pdp-buy__notify-done {
    margin: 0;
    margin-left: auto;
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: var(--text--h5);
  }

  /* Note pyramid (03 §3.2) */
  .pyramid {
    padding: var(--space--xl) var(--gutter);
    background: var(--color--black);
  }

  .pyramid__row {
    position: relative;
    padding: var(--space--m) 0;
  }

  .pyramid__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .pyramid__notes {
    margin: 0;
    font-size: var(--text--h3);
    font-weight: 800;
  }

  .pyramid__divider {
    display: block;
    height: 1px;
    margin-top: var(--space--m);
    background: var(--color--ink-3);
    transform-origin: left center;
  }

  /* Cross-sell (03 §3.4) — native overflow-x + scroll-snap only */
  .xsell {
    padding: 4rem var(--gutter) 6rem;
    background: var(--color--black);
  }

  .xsell__title {
    margin: 0 0 2rem;
    font-size: var(--text--h3);
    font-weight: 800;
  }

  .xsell__rail {
    display: flex;
    gap: var(--grid-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .xsell__item {
    flex: 0 0 16rem;
    scroll-snap-align: start;
  }

  /* `03 §3.4` asks for a drag-scroll rail with native snap. The rail always
     had `overflow-x: auto` and `scroll-snap-type`, but four 275x100px
     boxes never overflowed, so the interaction did not exist (review
     OSV-25). Cards now carry the bottle still and the scent's own notes,
     which is both the missing information and the height that makes the
     rail a rail. */
  .xsell__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--color--ink-2);
    border: 1px solid transparent;
    border-radius: var(--radius--xs);
    text-decoration: none;
    color: var(--color--white);
  }

  /* Flat-lit still on the scent's own ambient wash — tint as a light
     source, never as a text colour (01 §6.1). */
  .xsell__still {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 0.25rem;
    object-fit: contain;
    border-radius: var(--radius--xs);
    background: radial-gradient(
      circle at 50% 55%,
      color-mix(in oklab, var(--scent-tint) 22%, transparent),
      transparent 70%
    );
  }

  .xsell__notes {
    font-size: var(--text--eyebrow);
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .xsell__name {
    font-size: var(--text--h5);
    font-weight: 700;
  }

  .xsell__price {
    font-size: var(--text--eyebrow);
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .xsell__card {
      transition: border-color 0.3s;
    }

    .xsell__card:hover,
    .xsell__card:focus-visible {
      border-color: var(--scent-tint);
    }
  }

  @media (width <= 47.9375rem) {
    .pdp-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-bottom: 8rem; /* clears the sticky bar */
    }

    .pdp-buy {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 20;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .pdp-buy .btn-primary {
      flex: 1;
      margin-left: 0;
    }
  }
</style>
