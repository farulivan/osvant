---
// PLP (03 §2). Header + asymmetric editorial grid of 5 scent cards
// (01 §5.3). Grid entrance = one stagger group at 0.05s (03 §2 — carried
// to the card-entrance module via data-stagger). No filters/sort in v1.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTitle } from "../../lib/seo";
import ScentCard from "../../components/ScentCard.astro";
import { catalog as products, summaryNotes } from "../../lib/commerce";

// 03 §2 asymmetric editorial layout — alternating 2/3 split rows, fifth
// card full width. The card applies it (review OSV-04); this is the rhythm.
const SPANS: Array<1 | 2 | 3> = [2, 1, 1, 2, 3];
---

<BaseLayout
  title={pageTitle("collection")}
  description="Five currents — the osvant collection."
>
  <section
    class="min-h-screen bg-black px-gutter pt-32 pb-24"
    data-nav-theme="dark"
    aria-labelledby="plp-title"
  >
    <header class="relative mb-16">
      <p class="mb-4 eyebrow text-xs" data-eyebrow>all formulas</p>
      <h1 class="display text-h1" id="plp-title">
        <span class="block" data-anim="split">five</span>
        <span class="block" data-anim="split">currents</span>
      </h1>
      <p
        class="absolute top-0 right-0 text-xl text-haze-3"
        aria-label={`${products.length} scents`}
      >
        {String(products.length).padStart(2, "0")}
      </p>
    </header>

    {
      /* 03 §2 row hover — non-hovered cards dim to 60% (0.3s micro), with
        focus-within mirroring it for keyboard users. The `> article`
        selectors have to be written out: the children are ScentCard roots,
        so nothing on this element can reach them by class (review OSV-04). */
    }
    <div
      class="grid grid-cols-3 gap-5 max-lg:grid-cols-2 max-md:grid-cols-1 motion-safe:[&:focus-within>article:not(:hover,:focus-within)]:opacity-60 motion-safe:[&:hover>article:not(:hover,:focus-within)]:opacity-60 motion-safe:[&>article]:transition-opacity motion-safe:[&>article]:duration-300"
    >
      {
        products.map((product, index) => (
          <ScentCard
            scent={product.scent}
            name={product.name}
            batch={product.batch}
            notes={summaryNotes(product)}
            price={product.variants[0].price}
            stagger={0.05}
            span={SPANS[index] ?? 1}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
