---
// The House (03 §4): hero fragments `the lab` / `behind osvant` (M §4.2
// reveal), manifesto lead, pinned manifesto scrub
// (modules/house-manifesto.ts), craft grid with parallax macro
// photography, CTA band → collection.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";
import Duotone from "../components/Duotone.astro";
import { macro } from "../lib/photos";

// The manifesto is three statements, scrubbed one at a time (03 §4).
// Short enough that each holds a full screen at impact scale.
const statements = [
  "scent is a current, not a costume.",
  "we bottle provocation, not comfort.",
  "five formulas. nothing else.",
];

// Craft grid (03 §4). Each tile is a stage of the process, captioned —
// three unlabelled images say nothing about craft.
//
// These are ingredient macros standing in for process photography, which
// the asset set does not yet contain: the grid really wants a bench, an
// organ and a batch sheet. Chosen for field rather than for subject, so
// the three read as one set — all dark-field specimen plates. The
// full-frame bark texture that sat here first was matched on mean
// luminance (62 against saffron's 150) and still read as the brightest
// thing on the page, because mean luminance says nothing about how much
// of the frame is lit.
const craft = [
  {
    eyebrow: "maceration",
    caption: "six weeks in the dark. the formula stops being a list.",
    photo: macro.benzoin,
  },
  {
    eyebrow: "the organ",
    caption: "four hundred materials. we use thirty-one.",
    photo: macro.iris,
  },
  {
    eyebrow: "batch record",
    caption: "every bottle traceable to the day it was mixed.",
    photo: macro.saffron,
  },
];
---

<BaseLayout
  title={pageTitle("the house")}
  description="behind osvant — the brand story."
>
  {/* Hero — stacked fragments per 01 §3.3, reveal via data-anim="split" */}
  <section
    class="house-hero"
    data-nav-theme="dark"
    aria-labelledby="house-title"
  >
    <p class="house-hero__eyebrow" data-eyebrow>the lab</p>
    <h1 class="house-hero__title" id="house-title">
      <span class="house-hero__fragment" data-anim="split">the lab</span>
      <span class="house-hero__fragment" data-anim="split">behind osvant</span>
    </h1>
    <p class="house-hero__lead">
      we are a laboratory that sells five things. no seasonal editions, no
      flankers, no reformulations to hit a price. a formula either works or it
      does not leave the bench.
    </p>
  </section>

  {
    /* Pinned manifesto scrub (03 §4) — chars highlight ink-3 → white as
      scrolled; reversible scrub, never triggered-once */
  }
  <section
    class="manifesto"
    data-manifesto
    data-nav-theme="dark"
    aria-label="manifesto"
  >
    {
      statements.map((statement) => (
        <p class="manifesto__line" data-manifesto-line>
          {statement}
        </p>
      ))
    }
  </section>

  {
    /* Craft grid — macro photography parallax (03 §4); washes until the
      shoot lands (ADR-008) */
  }
  <section class="craft" data-nav-theme="dark" aria-labelledby="craft-title">
    <h2 class="craft__title" id="craft-title" data-anim="split">the craft</h2>
    <div class="craft__grid">
      {
        craft.map((tile) => (
          <figure class="craft__figure">
            <Duotone
              class="craft__tile"
              image={tile.photo.image}
              alt=""
              widths={[360, 560, 800]}
              sizes="(width <= 47.9375rem) 100vw, 33vw"
              exposure={tile.photo.exposure}
            />
            <figcaption class="craft__caption">
              <span class="craft__eyebrow" data-eyebrow>
                {tile.eyebrow}
              </span>
              {tile.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* CTA band → collection (03 §4) */}
  <section
    class="house-cta"
    data-nav-theme="dark"
    aria-labelledby="house-cta-title"
  >
    <p class="house-cta__eyebrow" data-eyebrow>five formulas</p>
    <h2 class="house-cta__title" id="house-cta-title" data-anim="split">
      the rest is on your skin
    </h2>
    <a class="btn-primary" href={withBase("collection")} data-anim="btn-line">
      <span data-btn-label>shop the collection</span>
    </a>
  </section>
</BaseLayout>

<style>
  .house-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 8rem var(--gutter) 4rem;
    background: var(--color--black);
  }

  .house-hero__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .house-hero__title {
    margin: 0;
  }

  .house-hero__fragment {
    display: block;
    font-size: var(--text--impact);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color--white);
  }

  .house-hero__lead {
    margin: 3rem 0 0;
    max-width: 34ch;
    font-size: var(--text--lead);
    color: var(--color--lilac-3);
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    min-height: 100vh;
    padding: 15vh var(--gutter);
    background: var(--color--black);
  }

  .manifesto__line {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text--h1);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1.05;
    color: var(--color--white); /* RM/static path: statements sit lit */
  }

  .craft {
    padding: 15vh var(--gutter);
    background: var(--color--black);
  }

  .craft__title {
    margin: 0 0 4rem;
    font-size: var(--text--h2);
    font-weight: 800;
    font-stretch: 125%;
    color: var(--color--white);
  }

  .craft__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }

  .craft__figure {
    margin: 0;
  }

  .craft__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space--2xs);
    margin-top: var(--space--xs);
    font-size: var(--text--h6);
    color: var(--color--lilac-2);
    max-width: 32ch;
  }

  .craft__eyebrow {
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .craft__figure :global(.craft__tile) {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius--media);
    overflow: hidden;
  }

  /* `03 §9` requires every animated section to resolve to a CTA. This one
     resolved to ONLY a CTA: a single centred button floating in a 300px
     band with nothing above it (review OSV-23). */
  .house-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 15vh var(--gutter);
    background: var(--color--ink-1);
    text-align: center;
  }

  .house-cta__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .house-cta__title {
    margin: 0 0 var(--space--lede-content);
    max-width: 18ch;
    font-size: var(--text--h2);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1.05;
  }

  /* Tablet (768–991px) had no layout of its own: the site defined four
     breakpoints in tokens and shipped one, so a 3-up grid stayed 3-up at
     834px and gave each cell ~240px (review OSV-13). */
  @media (61.9375rem >= width > 47.9375rem) {
    .craft__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width <= 47.9375rem) {
    .craft__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
