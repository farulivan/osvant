---
// The House (03 §4): hero fragments `the lab` / `behind osvant` (M §4.2
// reveal), manifesto lead [draft] (copy ships w5, RFC-001 C1), pinned
// manifesto scrub (modules/house-manifesto.ts), craft grid with parallax
// washes (ADR-008 until macro photography lands), CTA band → collection.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";

const statements = [
  "[draft] scent is a current, not a costume.",
  "[draft] we bottle provocation, not comfort.",
  "[draft] five formulas. nothing else.",
];
---

<BaseLayout
  title={pageTitle("the house")}
  description="behind osvant — the brand story."
>
  {/* Hero — stacked fragments per 01 §3.3, reveal via data-anim="split" */}
  <section
    class="house-hero"
    data-nav-theme="dark"
    aria-labelledby="house-title"
  >
    <p class="house-hero__eyebrow" data-eyebrow>the lab</p>
    <h1 class="house-hero__title" id="house-title">
      <span class="house-hero__fragment" data-anim="split">the lab</span>
      <span class="house-hero__fragment" data-anim="split">behind osvant</span>
    </h1>
    <p class="house-hero__lead">
      [draft] manifesto lead — ships w5 (RFC-001 C1).
    </p>
  </section>

  {
    /* Pinned manifesto scrub (03 §4) — chars highlight ink-3 → white as
      scrolled; reversible scrub, never triggered-once */
  }
  <section
    class="manifesto"
    data-manifesto
    data-nav-theme="dark"
    aria-label="manifesto"
  >
    {
      statements.map((statement) => (
        <p class="manifesto__line" data-manifesto-line>
          {statement}
        </p>
      ))
    }
  </section>

  {
    /* Craft grid — macro photography parallax (03 §4); washes until the
      shoot lands (ADR-008) */
  }
  <section class="craft" data-nav-theme="dark" aria-labelledby="craft-title">
    <h2 class="craft__title" id="craft-title" data-anim="split">the craft</h2>
    <div class="craft__grid">
      <div class="craft__tile" data-anim="parallax" aria-hidden="true"></div>
      <div class="craft__tile" data-anim="parallax" aria-hidden="true"></div>
      <div class="craft__tile" data-anim="parallax" aria-hidden="true"></div>
    </div>
  </section>

  {/* CTA band → collection (03 §4) */}
  <section class="house-cta" data-nav-theme="dark">
    <a class="btn-primary" href={withBase("collection")} data-anim="btn-line">
      <span data-btn-label>shop the collection</span>
    </a>
  </section>
</BaseLayout>

<style>
  .house-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 8rem var(--gutter) 4rem;
    background: var(--color--black);
  }

  .house-hero__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .house-hero__title {
    margin: 0;
  }

  .house-hero__fragment {
    display: block;
    font-size: var(--text--impact);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color--white);
  }

  .house-hero__lead {
    margin: 3rem 0 0;
    max-width: 34ch;
    font-size: var(--text--lead);
    color: var(--color--lilac-3);
  }

  .manifesto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    min-height: 100vh;
    padding: 15vh var(--gutter);
    background: var(--color--black);
  }

  .manifesto__line {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text--h1);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1.05;
    color: var(--color--white); /* RM/static path: statements sit lit */
  }

  .craft {
    padding: 15vh var(--gutter);
    background: var(--color--black);
  }

  .craft__title {
    margin: 0 0 4rem;
    font-size: var(--text--h2);
    font-weight: 800;
    font-stretch: 125%;
    color: var(--color--white);
  }

  .craft__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }

  .craft__tile {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius--media);
    overflow: hidden;
    background: radial-gradient(
      ellipse 70% 60% at 50% 55%,
      color-mix(in oklab, var(--color--uv) 22%, var(--color--ink-1)) 0%,
      var(--color--ink-1) 80%
    );
  }

  .house-cta {
    display: flex;
    justify-content: center;
    padding: 15vh var(--gutter);
    background: var(--color--ink-1);
  }

  @media (width <= 47.9375rem) {
    .craft__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
