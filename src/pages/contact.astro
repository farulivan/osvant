---
// Contact (03 §6) — split: business enquiries btn-text at h3 scale
// (mailto) / press + socials; form per 01 §5.5 line style with RFC-001
// C3 validation states. Mock relay (C3) — see modules/contact.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";

const socials = [
  { href: "https://instagram.com", label: "instagram" },
  { href: "https://tiktok.com", label: "tiktok" },
];
---

<BaseLayout
  title={pageTitle("contact")}
  description="Business enquiries and press — osvant."
>
  <section
    class="contact"
    data-nav-theme="dark"
    aria-labelledby="contact-title"
  >
    <div class="contact__intro">
      <p class="contact__eyebrow" data-eyebrow>contact</p>
      <h1 class="contact__title" id="contact-title" data-anim="split">
        get in touch
      </h1>
      <a class="contact__business" href="mailto:business@osvant.com">
        business enquiries -&gt; business@osvant.com
      </a>
      <p class="contact__press">
        press — <a href="mailto:press@osvant.com">press@osvant.com</a>
      </p>
      <ul class="contact__socials">
        {
          socials.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener">
                {item.label} -&gt;
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="contact__form-wrap">
      <form class="contact__form" data-contact-form novalidate>
        <div class="contact__field">
          <label class="contact__label" for="contact-name">name</label>
          <input
            id="contact-name"
            type="text"
            name="name"
            autocomplete="name"
            data-field="name"
          />
          <p class="contact__error" data-error-for="name" role="status"></p>
        </div>
        <div class="contact__field">
          <label class="contact__label" for="contact-email">email</label>
          <input
            id="contact-email"
            type="email"
            name="email"
            autocomplete="email"
            data-field="email"
          />
          <p class="contact__error" data-error-for="email" role="status"></p>
        </div>
        <div class="contact__field">
          <label class="contact__label" for="contact-message">message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            data-field="message"></textarea>
          <p class="contact__error" data-error-for="message" role="status"></p>
        </div>
        <button class="btn-primary" type="submit" data-contact-submit>
          <span data-btn-label>send</span>
        </button>
        <p class="contact__demo">demo — no message sent.</p>
      </form>

      <p class="contact__success" data-contact-success hidden role="status">
        sent. we'll be in touch.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact {
    display: grid;

    /* `1fr` is `minmax(auto, 1fr)`, so a track refuses to shrink below its
       content's min-content width — the column measured 350px inside a
       320px viewport and pushed the page into shrink-to-fit. `minmax(0,
       1fr)` lets it actually be fluid. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--grid-gap);
    min-height: 100vh;
    min-height: 100svh;
    padding: 8rem var(--gutter) 6rem;
    background: var(--color--black);
  }

  .contact__title {
    margin: 0 0 var(--space--headline-lede);
    font-size: var(--text--h1);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1.05;
  }

  /* Real labels above the line. `03 §6` puts them at --text--eyebrow in
     lilac-3, which is the same register the rest of the system uses for
     micro-labels — and it gives the page the information-design texture
     the review noted it was missing. */
  .contact__label {
    display: block;
    margin-bottom: var(--space--2xs);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--haze-3);
  }

  .contact__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--haze-3);
  }

  /* btn-text at h3 scale (03 §6) */
  .contact__business {
    display: inline-block;

    /* `business@osvant.com` is a single unbreakable 19-character token at
       --text--h3, which measures ~350px and refuses to fit a 280px column
       on a 320px screen — enough on its own to trigger shrink-to-fit. */
    overflow-wrap: anywhere;
    font-size: var(--text--h3);
    font-weight: 700;
    color: var(--color--white);
    text-decoration: none;
  }

  .contact__press {
    margin: 2rem 0 0;
    font-size: var(--text--body);
    color: var(--color--haze-3);
  }

  .contact__press a {
    color: var(--color--white);
    text-decoration: none;
  }

  .contact__socials {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .contact__socials a {
    color: var(--color--haze-3);
    font-size: var(--text--btn);
    text-decoration: none;
  }

  /* Form — inputs per 01 §5.5 line style */
  .contact__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.75rem;
  }

  /* `send` was the only full-width button on the site (review OSV-30).
     Nothing set `width: 100%` — the column's default `align-items:
     stretch` did it, which is why a grep for the width never found it. */
  .contact__form .btn-primary {
    align-self: flex-start;
  }

  .contact__form input,
  .contact__form textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color--ink-4);
    border-radius: 0;
    padding: 0.5rem 0;
    color: var(--color--white);
    font-size: var(--text--body);
    font-family: inherit;
    resize: vertical;
  }

  .contact__form input:focus-visible,
  .contact__form textarea:focus-visible {
    border-bottom-color: var(--color--phosphor);
    outline: none;
  }

  /* C3: validation message at eyebrow size, below field, amber */
  .contact__error {
    margin: 0.375rem 0 0;
    min-height: 1rem;
    font-size: var(--text--eyebrow);
    letter-spacing: 0.12em;
    color: var(--color--amber);
  }

  .contact__demo {
    margin: 0;
    font-size: var(--text--eyebrow);
    letter-spacing: 0.12em;
    color: var(--color--haze-3);
  }

  .contact__success {
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: var(--text--h4);
  }

  @media (width <= 47.9375rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
