---
// Contact (03 §6) — split: business enquiries btn-text at h3 scale
// (mailto) / press + socials; form per 01 §5.5 line style with RFC-001
// C3 validation states. Mock relay (C3) — see modules/contact.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";

// Inputs per 01 §5.5 line style: no box, one bottom rule that goes
// phosphor on focus. ink-4 and not ink-3 — this is a control boundary and
// needs 3:1 (01 §6.2).
const FIELD =
  "w-full resize-y rounded-none border-0 border-b border-b-ink-4 bg-transparent py-2 font-[inherit] text-lg text-white focus-visible:border-b-phosphor focus-visible:outline-none";

const socials = [
  { href: "https://instagram.com", label: "instagram" },
  { href: "https://tiktok.com", label: "tiktok" },
];
---

<BaseLayout
  title={pageTitle("contact")}
  description="Business enquiries and press — osvant."
>
  {
    /* grid-cols-2 is `repeat(2, minmax(0, 1fr))`, which is the fix this
      page needed spelled as a default: a bare `1fr` is `minmax(auto, 1fr)`
      and refuses to shrink below its content's min-content width, so the
      column measured 350px inside a 320px viewport and pushed the page
      into shrink-to-fit. */
  }
  <section
    class="grid min-h-svh grid-cols-2 gap-5 bg-black px-gutter pt-32 pb-24 max-md:grid-cols-1"
    data-nav-theme="dark"
    aria-labelledby="contact-title"
  >
    <div>
      <p class="mb-4 eyebrow text-xs" data-eyebrow>contact</p>
      <h1 class="mb-6 display text-h1" id="contact-title" data-anim="split">
        get in touch
      </h1>
      {
        /* btn-text at h3 scale (03 §6). `business@osvant.com` is a single
          unbreakable 19-character token that measures ~350px here and
          refuses to fit a 280px column on a 320px screen — enough on its
          own to trigger shrink-to-fit, hence wrap-anywhere. */
      }
      <a
        class="inline-block display text-3xl wrap-anywhere text-white no-underline"
        href="mailto:business@osvant.com"
      >
        business enquiries -&gt; business@osvant.com
      </a>
      <p class="mt-8 text-lg text-haze-3 [&_a]:text-white [&_a]:no-underline">
        press — <a href="mailto:press@osvant.com">press@osvant.com</a>
      </p>
      <ul
        class="mt-8 flex list-none gap-6 [&_a]:text-base [&_a]:text-haze-3 [&_a]:no-underline"
      >
        {
          socials.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener">
                {item.label} -&gt;
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <form
        class="flex flex-col items-stretch gap-7"
        data-contact-form
        novalidate
      >
        <div>
          {
            /* Real labels above the line. 03 §6 puts them at eyebrow scale
              in haze-3 — the register the rest of the system uses for
              micro-labels. */
          }
          <label class="mb-2 block eyebrow text-xs" for="contact-name">
            name
          </label>
          <input
            id="contact-name"
            class={FIELD}
            type="text"
            name="name"
            autocomplete="name"
            data-field="name"
          />
          {/* C3: validation message at eyebrow size, below the field, amber */}
          <p
            class="mt-1.5 min-h-4 eyebrow text-xs text-amber"
            data-error-for="name"
            role="status"
          >
          </p>
        </div>
        <div>
          <label class="mb-2 block eyebrow text-xs" for="contact-email">
            email
          </label>
          <input
            id="contact-email"
            class={FIELD}
            type="email"
            name="email"
            autocomplete="email"
            data-field="email"
          />
          <p
            class="mt-1.5 min-h-4 eyebrow text-xs text-amber"
            data-error-for="email"
            role="status"
          >
          </p>
        </div>
        <div>
          <label class="mb-2 block eyebrow text-xs" for="contact-message">
            message
          </label>
          <textarea
            id="contact-message"
            class={FIELD}
            name="message"
            rows="4"
            data-field="message"></textarea>
          <p
            class="mt-1.5 min-h-4 eyebrow text-xs text-amber"
            data-error-for="message"
            role="status"
          >
          </p>
        </div>
        {
          /* self-start: `send` was the only full-width button on the site
            (review OSV-30). Nothing set `width: 100%` — the column's
            `align-items: stretch` did it, which is why a grep for the
            width never found it. */
        }
        <button
          class="btn-primary self-start"
          type="submit"
          data-contact-submit
        >
          <span data-btn-label>send</span>
        </button>
        <p class="eyebrow text-xs">demo — no message sent.</p>
      </form>

      <p class="text-2xl" data-contact-success hidden role="status">
        sent. we'll be in touch.
      </p>
    </div>
  </section>
</BaseLayout>
