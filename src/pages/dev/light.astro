---
import "../../styles/dev-light.css";
// /dev/light — the bottle-still acceptance harness (06 §2, M §8).
//
// This is the instrument the handoff checklist names. A candidate master
// is accepted only when, in here:
//   1. sweeping --light-angle 0 → 1 makes the highlight visibly MOVE —
//      if it doesn't, the master carries its own baked lighting and
//      double-lights against layers 3 and 4 (M §8.3);
//   2. the silhouette edge stays clean against both grounds — the same
//      alpha masks layers 3 and 4, so a contaminated edge reads as a
//      glowing outline;
//   3. all five overlaid register within 2px, or the procession jitters.
//
// Staging only, `noindex` — DevHarness handles both.
import DevHarness from "../../layouts/DevHarness.astro";
import LightStudy from "../../components/LightStudy.astro";
import { stillFor } from "../../lib/stills";

const SCENTS = ["volt", "nocturne", "static", "fever", "halo"] as const;

// Resolved through the same registry the real pages use, so the harness
// can never disagree with what actually ships.
const stills = SCENTS.map((scent) => ({ scent, image: stillFor(scent) }));
---

<DevHarness title="light study" spec="M §8 · 06 §2">
  <section class="flex flex-col gap-8" data-light-harness>
    <div
      class="flex flex-wrap items-start gap-x-10 gap-y-6 rounded-sm bg-ink-1 p-5"
    >
      <label class="flex min-w-64 flex-col gap-2">
        <span class="eyebrow text-xs">
          --light-angle <output data-angle-out>0.50</output>
        </span>
        <input
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="0.5"
          data-angle
        />
      </label>

      <label class="flex min-w-0 flex-row items-center gap-2">
        <input type="checkbox" data-ambient checked />
        <span class="eyebrow text-xs">ambient oscillation (0.45 ↔ 0.55)</span>
      </label>

      <label class="flex min-w-0 flex-row items-center gap-2">
        <input type="checkbox" data-sweep />
        <span class="eyebrow text-xs"
          >auto-sweep 0 → 1 (acceptance check 1)</span
        >
      </label>

      <label class="flex min-w-0 flex-row items-center gap-2">
        <input type="checkbox" data-light-ground />
        <span class="eyebrow text-xs">light ground (edge/fringe check)</span>
      </label>

      <fieldset
        class="flex flex-row flex-wrap gap-3 rounded-sm border border-ink-3 p-3"
      >
        <legend class="eyebrow text-xs">isolate layer</legend>
        {
          ["all", "wash", "caustic", "bottle", "sheen", "rim", "vapor"].map(
            (layer, i) => (
              <label class="flex flex-row items-center gap-2">
                <input
                  type="radio"
                  name="layer"
                  value={layer}
                  checked={i === 0}
                  data-layer
                />
                <span>{layer}</span>
              </label>
            ),
          )
        }
      </fieldset>
    </div>

    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(12rem,1fr))] gap-6"
      data-stages
    >
      {
        stills.map(({ scent, image }) => (
          <figure
            class="[&_figcaption]:mt-2 [&_figcaption]:text-xs [&_figcaption]:tracking-[0.12em] [&_figcaption]:text-haze-3"
            data-stage
          >
            <LightStudy
              scent={scent}
              alt={`the ${scent} bottle`}
              image={image}
              width={620}
              eager
            />
            <figcaption>{scent}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="registration">
      <p class="max-w-[60ch] text-xs tracking-[0.06em] text-haze-3">
        Registration check — all five stacked at 40% opacity. Any silhouette
        that does not sit exactly on the others will read as a double edge here,
        and as a jitter in the procession.
      </p>
      <div
        class="relative grid max-w-96 [&>*]:col-start-1 [&>*]:row-start-1 [&>*]:opacity-40"
      >
        {
          stills.map(({ scent, image }) => (
            <LightStudy scent={scent} alt="" image={image} width={620} eager />
          ))
        }
      </div>
    </div>
  </section>
</DevHarness>

<script>
  import { createLightStudy } from "../../scripts/modules/light-study";
  import gsap from "gsap";

  const root = document.querySelector<HTMLElement>("[data-light-harness]");
  const stages = root?.querySelectorAll<HTMLElement>("[data-light-study]");
  if (root && stages?.length) {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const studies = [...stages].map((stage) =>
      createLightStudy(stage, { reducedMotion }),
    );

    const angleInput = root.querySelector<HTMLInputElement>("[data-angle]");
    const angleOut = root.querySelector<HTMLOutputElement>("[data-angle-out]");
    const ambient = root.querySelector<HTMLInputElement>("[data-ambient]");
    const sweep = root.querySelector<HTMLInputElement>("[data-sweep]");
    const ground = root.querySelector<HTMLInputElement>("[data-light-ground]");

    const show = (angle: number) => {
      if (angleOut) angleOut.textContent = angle.toFixed(2);
      if (angleInput) angleInput.value = String(angle);
    };

    const setAll = (angle: number) => {
      for (const study of studies) study.set(angle);
      show(angle);
    };

    angleInput?.addEventListener("input", () => {
      if (ambient) ambient.checked = false;
      if (sweep) sweep.checked = false;
      sweepTween?.kill();
      setAll(Number(angleInput.value));
    });

    ambient?.addEventListener("change", () => {
      if (ambient.checked) {
        for (const study of studies) study.resumeAmbient();
      } else {
        for (const study of studies) study.stopAmbient();
      }
    });

    let sweepTween: gsap.core.Tween | null = null;
    sweep?.addEventListener("change", () => {
      sweepTween?.kill();
      if (!sweep.checked) return;
      if (ambient) ambient.checked = false;
      const carrier = { angle: 0 };
      sweepTween = gsap.fromTo(
        carrier,
        { angle: 0 },
        {
          angle: 1,
          duration: 4,
          ease: "none",
          yoyo: true,
          repeat: -1,
          onUpdate: () => setAll(carrier.angle),
        },
      );
    });

    ground?.addEventListener("change", () => {
      root.classList.toggle("panel--light", ground.checked);
    });

    root.querySelectorAll<HTMLInputElement>("[data-layer]").forEach((radio) => {
      radio.addEventListener("change", () => {
        root.dataset.isolate = radio.value;
      });
    });
  }
</script>
