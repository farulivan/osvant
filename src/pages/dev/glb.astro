---
// /dev/glb — GLB handoff harness (06-asset-pipeline §2). Lists the binding
// acceptance criteria and probes for each contracted file. The three.js
// viewer (lazy chunk, M §10; ADR-006) lands with the first real GLB in w4 —
// until then this page is the acceptance checklist + presence probe.
import DevHarness from "../../layouts/DevHarness.astro";
import { getProducts } from "../../lib/commerce";

const scents = (await getProducts()).map((product) => product.scent);

const CRITERIA = [
  "≤1.5MB per bottle (CI asset guard enforces)",
  "gltf-validator: zero errors",
  "textures ≤2K, KTX2 where the material allows",
  "draco-compressed",
  "shared silhouette, per-scent material",
  "origin at base center, +Y up, real-world scale",
  "loads with the shared 2K HDR env (env-studio.hdr — engineering supplies it)",
];
---

<DevHarness title="glb handoff" spec="06-assets §2 · M §8">
  <section class="harness-block">
    <h2 class="harness-block__title">acceptance criteria (binding)</h2>
    <ul class="harness-list">
      {CRITERIA.map((criterion) => <li>{criterion}</li>)}
    </ul>
  </section>

  <section class="harness-block">
    <h2 class="harness-block__title">asset presence probe</h2>
    <table class="harness-table">
      <thead>
        <tr>
          <th>file</th>
          <th>status</th>
        </tr>
      </thead>
      <tbody>
        {
          scents.map((scent) => (
            <tr>
              <td>
                <code>bottle-{scent}.glb</code>
              </td>
              <td data-probe={`assets/models/bottle-${scent}.glb`}>…</td>
            </tr>
          ))
        }
        <tr>
          <td><code>env-studio.hdr</code></td>
          <td data-probe="assets/models/env-studio.hdr">…</td>
        </tr>
      </tbody>
    </table>
  </section>
</DevHarness>

<script>
  import { withBase } from "../../lib/url";

  document
    .querySelectorAll<HTMLElement>("[data-probe]")
    .forEach(async (cell) => {
      const path = cell.dataset.probe ?? "";
      try {
        const response = await fetch(withBase(path), { method: "HEAD" });
        cell.textContent = response.ok ? "present" : "missing";
        cell.dataset.status = response.ok ? "present" : "missing";
      } catch {
        cell.textContent = "missing";
        cell.dataset.status = "missing";
      }
    });
</script>

<style>
  .harness-block__title {
    font-size: var(--text--h4);
    margin: 0 0 0.75rem;
  }

  .harness-list {
    color: var(--color--lilac-3);
    font-size: var(--text--body);
    margin: 0;
    padding-left: 1.25rem;
  }

  .harness-table {
    border-collapse: collapse;
    font-size: var(--text--body);
  }

  .harness-table th,
  .harness-table td {
    padding: 0.5rem 1.5rem 0.5rem 0;
    text-align: left;
    border-bottom: 1px solid var(--color--ink-3);
  }

  .harness-table th {
    color: var(--color--lilac-3);
    font-weight: 500;
  }

  [data-status="present"] {
    color: var(--color--uv);
  }

  [data-status="missing"] {
    color: var(--color--amber);
  }
</style>
