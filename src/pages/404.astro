---
// 404 (03-page-specs.md §7). Uses BaseLayout directly (not StubSection) —
// this page's copy/CTA are final per spec, not a placeholder.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";
---

<BaseLayout
  title={pageTitle("not found")}
  description="nothing to smell here — osvant."
  noindex
>
  <section class="not-found" data-nav-theme="dark">
    <h1 class="not-found__title">nothing to smell here.</h1>
    <a class="btn-primary" href={withBase("collection")}>
      <span data-btn-label>back to the current</span>
    </a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
    min-height: 100vh;
    padding: 0 var(--gutter);
  }

  .not-found__title {
    font-size: var(--text--impact);
    margin: 0;
  }

  .btn-primary {
    display: inline-flex;
    background: var(--color--uv);
    color: var(--color--black);
    border-radius: var(--radius--xs);
    padding: 0.75rem 1.5rem;
    font-size: var(--text--btn);
    text-decoration: none;
  }
</style>
