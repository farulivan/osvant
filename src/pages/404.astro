---
// 404 (03-page-specs.md §7). Uses BaseLayout directly (not StubSection) —
// this page's copy/CTA are final per spec, not a placeholder.
//
// No local .btn-primary here. This page used to re-declare the whole
// component, and because Astro's scoped styles outrank the global sheet
// the copy won — including its `color: var(--color--black)`, which never
// received the 2026-08-26 --color--on-phosphor amendment (01 §2.1). That
// left 404 as the last page failing Lighthouse's colour-contrast audit at
// 4.47:1. app.css owns the component; nothing here may restate it.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/seo";
import { withBase } from "../lib/url";
---

<BaseLayout
  title={pageTitle("not found")}
  description="nothing to smell here — osvant."
  noindex
>
  <section
    class="flex min-h-screen flex-col items-start justify-center gap-8 px-gutter"
    data-nav-theme="dark"
  >
    <h1 class="display text-impact">nothing to smell here.</h1>
    <a class="btn-primary" href={withBase("collection")}>
      <span data-btn-label>back to the current</span>
    </a>
  </section>
</BaseLayout>
