---
// Journal article template (03 §5): lead image parallax (M §4.5),
// --text--body two-thirds column, pull-quotes (markdown blockquote) in
// the muted tone rung, ends with a cross-sell band. Content renders
// fully at build — zero content JS ships (07 §2, ADR-010).
// Lead image is a wash placeholder until photography lands (ADR-008).
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/url";
import { pageTitle } from "../../lib/seo";
import { catalog as products } from "../../lib/commerce";

export async function getStaticPaths() {
  const articles = await getCollection("journal");
  return articles.map((article) => ({
    params: { slug: article.id.replace(/\.md$/, "") },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const linked = article.data.scent
  ? products.find((p) => p.scent === article.data.scent)
  : undefined;
---

<BaseLayout
  title={pageTitle(article.data.title)}
  description={`${article.data.title} — the osvant journal.`}
  ogType="article"
  ogImage={article.data.ogOverride}
>
  <article class="bg-black px-gutter pt-[20vh]" data-nav-theme="dark">
    <header class="max-w-[20ch]">
      <p class="mb-6 eyebrow text-xs" data-eyebrow>
        <time datetime={article.data.date.toISOString()}>
          {
            new Intl.DateTimeFormat("en-GB", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
              .format(article.data.date)
              .toLowerCase()
          }
        </time>
      </p>
      <h1 class="mb-16 display text-h2 text-white">{article.data.title}</h1>
    </header>

    {
      /* ADR-008: wash placeholder until leadImage photography lands —
        data-anim="parallax" wires the M §4.5 scrub with real media. */
    }
    <div
      class="aspect-video overflow-hidden rounded-media scent-wash"
      data-anim="parallax"
      role="img"
      aria-label={article.data.leadImage.alt}
    >
    </div>

    <div
      class="mx-auto mt-20 max-w-[66.667%] text-lg leading-relaxed text-haze-2 max-md:max-w-full [&_blockquote]:my-[3em] [&_blockquote]:border-l [&_blockquote]:border-phosphor [&_blockquote]:pl-6 [&_blockquote]:text-3xl [&_blockquote]:leading-tight [&_blockquote]:text-haze-3 [&_blockquote_p]:m-0 [&_h3]:mt-[3em] [&_h3]:mb-[1em] [&_h3]:display [&_h3]:text-3xl [&_h3]:text-white [&_p]:mb-[1.5em]"
    >
      <Content />
    </div>

    {
      /* Cross-sell band (03 §5): the scent this article belongs to, or the
        full collection when the article is scent-agnostic (RFC B6). */
    }
  </article>

  {
    /* A top-level section, a SIBLING of the article — not a child. The
      negative gutter margins here were a full-bleed breakout with nothing
      to break out of, so the band overhung the viewport by a gutter on
      each side at every width (1440 + 2x57.6 = 1555px measured). It is
      already full-bleed; it only needs its own padding. */
  }
  <section
    class="mt-32 bg-ink-1 px-gutter py-16"
    data-nav-theme={linked ? "scent" : "dark"}
    data-scent={linked?.scent}
    aria-label="keep browsing"
  >
    {
      linked ? (
        <a
          class="flex flex-col gap-2 no-underline"
          href={withBase(`collection/${linked.scent}/`)}
        >
          <span class="eyebrow text-xs" data-eyebrow>
            in this story
          </span>
          <span class="display text-h2 text-scent-tint-text">
            {linked.name}
          </span>
          <span class="text-base text-white">
            €{linked.variants[0].price} — discover
          </span>
        </a>
      ) : (
        <a
          class="flex flex-col gap-2 no-underline"
          href={withBase("collection")}
        >
          <span class="eyebrow text-xs" data-eyebrow>
            the collection
          </span>
          <span class="display text-h2 text-scent-tint-text">
            five currents
          </span>
          <span class="text-base text-white">shop the collection</span>
        </a>
      )
    }
  </section>
</BaseLayout>
