---
// Journal index (03 §5): title `transmissions`, article cards (image,
// eyebrow date, title h3), stagger entrance via data-anim="card" (M §4.3
// shared behavior). Content = `journal` collection (07 §2, ADR-010).
// Lead images are wash placeholders until photography lands (ADR-008).
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTitle } from "../../lib/seo";
import { withBase } from "../../lib/url";

const articles = (await getCollection("journal")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
});
---

<BaseLayout
  title={pageTitle("journal")}
  description="transmissions — the osvant journal."
>
  <section
    class="min-h-screen bg-black px-gutter pt-40 pb-32"
    data-nav-theme="dark"
    aria-labelledby="journal-title"
  >
    <h1 class="mb-16 display text-impact text-white" id="journal-title">
      transmissions
    </h1>

    {
      /* Tablet had no layout of its own: the site defined four breakpoints
        in tokens and shipped one, so a 3-up grid stayed 3-up at 834px and
        gave each cell ~240px (review OSV-13). */
    }
    <ul
      class="grid list-none grid-cols-3 gap-5 max-lg:grid-cols-2 max-md:grid-cols-1"
    >
      {
        articles.map((article) => (
          <li data-anim="card">
            <a
              class="group flex flex-col gap-3 no-underline"
              href={withBase(`journal/${article.id.replace(/\.md$/, "")}/`)}
              data-scent={article.data.scent}
            >
              {/* ADR-008: wash placeholder until leadImage photography lands */}
              <span
                class="aspect-4/3 rounded-media scent-wash"
                aria-hidden="true"
              />
              <span class="eyebrow text-xs">
                <time datetime={article.data.date.toISOString()}>
                  {dateFmt.format(article.data.date).toLowerCase()}
                </time>
              </span>
              <span class="display text-3xl text-white group-hover:text-scent-tint-text">
                {article.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
