---
// The light study — the bottle presentation contract (M §8, ADR-013).
//
// The principle: the object is fixed, the light moves. Depth comes from
// differential motion between layers, never from geometry.
//
// Exactly six layers, back to front (M §8.1). Only layer 2 is a produced
// asset; layers 0, 1, 3 and 4 are CSS, and layer 5 takes the Rive `vapor`
// artboard when it lands (06 §1) — a gradient plate until then.
//
// Layers 3 and 4 clip to the bottle silhouette via `mask-image` reading
// layer 2's OWN alpha channel — one asset reused as its own mask. There is
// deliberately no separate mask file (M §8.1).
//
// Everything responds to one custom property, `--light-angle` (M §8.2).
// That is what makes the mechanic source-agnostic: N=1 ships now, and an
// N=8 lit-state sequence or an N=24 sprite-sheet turntable drops in later
// with no code change. Do not add a second parameter.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Drives --scent-tint through one attribute swap (01 §2.3). */
  scent: string;
  /** Alt text for the bottle image. */
  alt: string;
  image: ImageMetadata;
  /** Rendered width of the AVIF derivative. */
  width?: number;
  /** The gallery's first bottle and the PDP hero paint above the fold. */
  eager?: boolean;
}

const { scent, alt, image, width = 1000, eager = false } = Astro.props;

// One derivative, used as BOTH the visible image and the mask source for
// layers 3 and 4 — so they can never drift out of register.
const bottle = await getImage({ src: image, format: "avif", width });
---

<div
  class="light-study"
  data-light-study
  data-scent={scent}
  style={`--bottle-mask: url("${bottle.src}");`}
>
  {/* 0 — tint wash: the ambient ground the bottle sits in */}
  <div class="light-study__wash" aria-hidden="true"></div>

  {/* 1 — caustic: slides INVERSE to the light, like a cast pool */}
  <div class="light-study__caustic" aria-hidden="true"></div>

  {/* 2 — the bottle: the only produced asset, flat-lit (M §8.3) */}
  <img
    class="light-study__bottle"
    src={bottle.src}
    width={bottle.attributes.width ?? width}
    height={bottle.attributes.height}
    alt={alt}
    decoding="async"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />

  {
    /* 3 — sheen: the specular band, masked to the glass. The mask lives on
      the wrapper and never moves; the beam inside it is what travels, so
      the highlight stays clipped to the silhouette instead of dragging a
      bottle-shaped ghost around with it. */
  }
  <div class="light-study__sheen" aria-hidden="true">
    <span class="light-study__beam"></span>
  </div>

  {/* 4 — rim: the tinted edge light, opposite the sheen. Same split. */}
  <div class="light-study__rim" aria-hidden="true">
    <span class="light-study__beam"></span>
  </div>

  {/* 5 — vapor: Rive `vapor` when it lands (06 §1); plate until then */}
  <div class="light-study__vapor" aria-hidden="true"></div>
</div>

<style>
  .light-study {
    position: relative;
    display: grid;
    perspective: 1200px;

    /* Reserves the slot before the image decodes — the CLS budget is
       unchanged by the light study (M §8.4). */
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }

  .light-study > * {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  /* --- 0. tint wash — slowest parallax (0.4×), blooms on active --- */
  .light-study__wash {
    background: radial-gradient(
      ellipse 58% 46% at 50% 56%,
      color-mix(in oklab, var(--scent-tint) 34%, transparent) 0%,
      transparent 72%
    );
    opacity: calc(0.35 + var(--light-bloom) * 0.65);
    transform: translate3d(
        calc((var(--light-angle) - 0.5) * -6% + var(--light-parallax) * -0.6),
        0,
        0
      )
      rotateY(calc(var(--light-tilt) * 1deg));
  }

  /* --- 1. caustic — screen, slides inverse to the light --- */
  .light-study__caustic {
    background: radial-gradient(
      ellipse 26% 12% at 50% 78%,
      color-mix(in oklab, var(--scent-tint) 60%, transparent) 0%,
      transparent 70%
    );
    filter: blur(18px);
    mix-blend-mode: screen;
    opacity: calc(0.5 + var(--light-bloom) * 0.5);
    transform: translate3d(calc((0.5 - var(--light-angle)) * 46%), 0, 0);
  }

  /* --- 2. the bottle — 1× parallax, scales when active --- */
  .light-study__bottle {
    object-fit: contain;
    transform: rotateY(calc(var(--light-tilt) * 3deg));
  }

  /* --- 3 & 4 — the masked pair.
     Clipped to layer 2's own alpha; no separate mask file (M §8.1).
     The wrapper carries the mask and is never transformed — moving a
     masked element moves its mask too, which drags a bottle-shaped ghost
     across the stage instead of sliding a highlight along the glass. --- */
  .light-study__sheen,
  .light-study__rim {
    /* `relative` is load-bearing: without it the absolutely-positioned
       beam resolves against the stage instead of this wrapper, escapes
       the overflow clip, and the mask lands out of register. */
    position: relative;
    mask-image: var(--bottle-mask);
    mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
    overflow: hidden;
  }

  /* The beam is wider than its window so travelling never exposes an edge. */
  .light-study__beam {
    position: absolute;
    inset: 0 -35%;
    display: block;
  }

  /* --- 3. sheen — overlay, tracks the light in position AND angle --- */
  .light-study__sheen {
    mix-blend-mode: overlay;
    opacity: calc(0.4 + var(--light-bloom) * 0.6);
  }

  .light-study__sheen .light-study__beam {
    background: linear-gradient(
      calc(74deg + (var(--light-angle) - 0.5) * 46deg),
      transparent 30%,
      color-mix(in oklab, var(--color--white) 58%, transparent) 46%,
      color-mix(in oklab, var(--color--white) 16%, transparent) 55%,
      transparent 70%
    );
    transform: translate3d(calc((var(--light-angle) - 0.5) * 46%), 0, 0);
  }

  /* --- 4. rim — screen, tinted, opposite the sheen --- */
  .light-study__rim {
    mix-blend-mode: screen;
    opacity: calc(0.35 + var(--light-bloom) * 0.65);
  }

  .light-study__rim .light-study__beam {
    background: linear-gradient(
      calc(254deg + (var(--light-angle) - 0.5) * 46deg),
      transparent 42%,
      color-mix(in oklab, var(--scent-tint) 75%, transparent) 60%,
      transparent 74%
    );
    transform: translate3d(calc((0.5 - var(--light-angle)) * 30%), 0, 0);
  }

  /* --- 5. vapor — fastest parallax (1.6×); Rive artboard when it lands --- */
  .light-study__vapor {
    background: radial-gradient(
      ellipse 44% 34% at 62% 34%,
      color-mix(in oklab, var(--scent-tint) 18%, transparent) 0%,
      transparent 68%
    );
    mix-blend-mode: screen;
    opacity: calc(var(--light-bloom) * 0.7);
    transform: translate3d(
        calc((var(--light-angle) - 0.5) * 12% + var(--light-parallax) * 0.6),
        0,
        0
      )
      rotateY(calc(var(--light-tilt) * 5deg));
  }
</style>
