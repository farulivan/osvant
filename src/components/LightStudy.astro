---
// The light study — the bottle presentation contract (M §8, ADR-013).
//
// The principle: the object is fixed, the light moves. Depth comes from
// differential motion between layers, never from geometry.
//
// Exactly six layers, back to front (M §8.1). Only layer 2 is a produced
// asset; layers 0, 1, 3 and 4 are CSS, and layer 5 takes the Rive `vapor`
// artboard when it lands (06 §1) — a gradient plate until then.
//
// Layers 3 and 4 clip to the bottle silhouette via `mask-image` reading
// layer 2's OWN alpha channel — one asset reused as its own mask. There is
// deliberately no separate mask file (M §8.1).
//
// Everything responds to one custom property, `--light-angle` (M §8.2).
// That is what makes the mechanic source-agnostic: N=1 ships now, and an
// N=8 lit-state sequence or an N=24 sprite-sheet turntable drops in later
// with no code change. Do not add a second parameter.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Drives --scent-tint through one attribute swap (01 §2.3). */
  scent: string;
  /** Alt text for the bottle image. */
  alt: string;
  image: ImageMetadata;
  /** Rendered width of the AVIF derivative. */
  width?: number;
  /** The gallery's first bottle and the PDP hero paint above the fold. */
  eager?: boolean;
}

const { scent, alt, image, width = 1000, eager = false } = Astro.props;

// One derivative, used as BOTH the visible image and the mask source for
// layers 3 and 4 — so they can never drift out of register.
const bottle = await getImage({ src: image, format: "avif", width });
---

<div
  class="light-study"
  data-light-study
  data-scent={scent}
  style={`--bottle-mask: url("${bottle.src}");`}
>
  {/* 0 — tint wash: the ambient ground the bottle sits in */}
  <div class="light-study__wash" aria-hidden="true"></div>

  {/* 1 — caustic: slides INVERSE to the light, like a cast pool */}
  <div class="light-study__caustic" aria-hidden="true"></div>

  {/* 2 — the bottle: the only produced asset, flat-lit (M §8.3) */}
  <img
    class="light-study__bottle"
    src={bottle.src}
    width={bottle.attributes.width ?? width}
    height={bottle.attributes.height}
    alt={alt}
    decoding="async"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />

  {
    /* 3 — sheen: the specular band, masked to the glass. The mask lives on
      the wrapper and never moves; the beam inside it is what travels, so
      the highlight stays clipped to the silhouette instead of dragging a
      bottle-shaped ghost around with it. */
  }
  <div class="light-study__sheen" aria-hidden="true">
    <span class="light-study__beam"></span>
  </div>

  {/* 4 — rim: the tinted edge light, opposite the sheen. Same split. */}
  <div class="light-study__rim" aria-hidden="true">
    <span class="light-study__beam"></span>
  </div>

  {/* 5 — vapor: Rive `vapor` when it lands (06 §1); plate until then */}
  <div class="light-study__vapor" aria-hidden="true"></div>
</div>
