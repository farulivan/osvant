---
// Home hero — the name (03 §1.2). Impact char cascade via the shared
// split module (data-anim="split"), scroll-out + chip + vapor placeholder
// orchestrated by modules/home-hero.ts (data-hero).
//
// Vapor: `vapor.riv` lands M3 (06 §1) — the [data-vapor] element is the
// placeholder-first stand-in (ADR-008): a duotone gradient wash whose
// opacity IS the intensity channel, so the velocity wiring is real today
// and the Rive artboard drops in later without touching the module.
import { withBase } from "../lib/url";
---

<section
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-black px-gutter"
  data-nav-theme="dark"
  data-hero
  data-nav-transparent
>
  <div
    class="pointer-events-none absolute -inset-[20%] opacity-35 hero-vapor motion-reduce:opacity-20"
    data-vapor
    aria-hidden="true"
  >
  </div>

  <a
    class="absolute top-22 right-gutter flex flex-col gap-1 rounded-sm border border-ink-4 px-4 py-3 text-white no-underline"
    data-hero-chip
    href={withBase("journal/001-batch-002/")}
  >
    <span class="eyebrow text-xs">next drop</span>
    <span class="text-base">batch 002 — fall</span>
  </a>

  <div class="relative">
    <p class="mb-4 eyebrow text-xs" data-eyebrow>
      eau de parfum — est. batch 001
    </p>
    <h1 class="display text-impact" data-anim="split">osvant</h1>
    <p
      class="mt-6 whisper text-2xl [&_em]:text-white [&_em]:not-italic"
      data-hero-subline
    >
      scent <em>beyond</em> the visible
    </p>
  </div>

  <div class="absolute bottom-8 left-gutter flex items-center gap-4">
    {/* btn-text already sets the reset this element used to restate. */}
    <button class="btn-text" type="button" data-hero-cue>
      <span data-btn-label>explore the collection</span>
    </button>
    <span
      class="block h-12 w-px origin-top bg-haze-3"
      data-hero-cue-line
      aria-hidden="true"></span>
  </div>
</section>
