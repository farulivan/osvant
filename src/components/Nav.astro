---
// Fixed nav bar (01-design-system.md §5.2). Lives OUTSIDE [data-taxi] — it
// persists across navigations; only its theme classes change (core/nav.ts).
import { withBase } from "../lib/url";

const links = [
  { href: "collection", label: "collection" },
  { href: "the-house", label: "the house" },
  { href: "journal", label: "journal" },
  { href: "contact", label: "contact" },
];
---

<nav data-nav class="nav">
  <a class="nav__logo" href={withBase("/")} aria-label="osvant — home">
    <!-- Rive `logo` artboard placeholder: static SVG wordmark (06-asset-pipeline §1) -->
    <svg
      class="nav__logo-mark"
      viewBox="0 0 96 20"
      role="img"
      aria-hidden="true"
    >
      <text x="0" y="15" font-family="Archivo, sans-serif" font-weight="800"
        >osvant</text
      >
    </svg>
  </a>

  <button
    class="nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-menu"
    data-nav-toggle
  >
    <span class="visually-hidden">Menu</span>
    <span class="nav__toggle-bar" aria-hidden="true"></span>
  </button>

  <div id="nav-menu" class="nav__menu" data-nav-menu>
    <ul class="nav__links">
      {
        links.map((link) => (
          <li>
            <a href={withBase(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <button class="nav__cart" type="button" data-cart-open aria-label="Cart">
      cart
      <span class="nav__cart-count" data-cart-count>0</span>
    </button>
  </div>
</nav>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
    background: transparent;
    transition:
      background-color 0.3s,
      backdrop-filter 0.3s;
  }

  .nav--solid {
    background: rgb(17 16 19 / 80%);
    backdrop-filter: blur(12px);
  }

  .nav__logo {
    display: inline-flex;
  }

  .nav__logo-mark {
    width: 6rem;
    height: 1.25rem;
  }

  .nav__logo-mark text {
    fill: var(--color--white);
  }

  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--color--white);
    cursor: pointer;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav__links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a,
  .nav__cart {
    color: var(--color--white);
    text-decoration: none;
    font-size: var(--text--btn);
  }

  .nav__cart {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .nav__cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    border-radius: 50%;
    background: var(--color--amber);
    color: var(--color--black);
    font-size: var(--text--eyebrow);
  }

  .nav--theme-light .nav__logo-mark text,
  .nav--theme-light .nav__links a,
  .nav--theme-light .nav__cart {
    fill: var(--color--black);
    color: var(--color--black);
  }

  .nav--theme-dark .nav__logo-mark text,
  .nav--theme-dark .nav__links a,
  .nav--theme-dark .nav__cart {
    fill: var(--color--white);
    color: var(--color--white);
  }

  .nav--theme-scent .nav__logo-mark text,
  .nav--theme-scent .nav__links a,
  .nav--theme-scent .nav__cart {
    fill: var(--scent-tint);
    color: var(--scent-tint);
  }

  @media (width <= 767px) {
    .nav__toggle {
      display: inline-flex;
    }

    .nav__menu {
      position: fixed;
      inset: 0;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      background: var(--color--ink-1);
      transform: translateX(100%);
      transition: transform 0.3s;
    }

    .nav__menu[data-open="true"] {
      transform: translateX(0);
    }

    .nav__links {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      font-size: var(--text--h2);
    }
  }
</style>

<script>
  // Menu disclosure only — the animated staggered entrance (§5.2) is a
  // motion-layer concern for a later PageModule; this is the accessible
  // CSS-only fallback it upgrades from.
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.dataset.open === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    if (menu) menu.dataset.open = String(!isOpen);
  });
</script>
