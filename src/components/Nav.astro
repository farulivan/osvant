---
// Fixed nav bar (01-design-system.md §5.2). Lives OUTSIDE [data-taxi] — it
// persists across navigations; only its theme classes change (core/nav.ts).
// The mobile overlay menu is driven by modules/nav-menu.ts (boot-mounted).
import { withBase } from "../lib/url";

const links = [
  { href: "collection", label: "collection" },
  { href: "the-house", label: "the house" },
  { href: "journal", label: "journal" },
  { href: "contact", label: "contact" },
];
---

<nav
  data-nav
  class="nav group fixed inset-x-0 top-0 z-100 flex items-center justify-between px-gutter py-5 [transition:background-color_0.3s,backdrop-filter_0.3s]"
>
  {
    /* The scent marker rides ::after so the anchor keeps one box. It is
      revealed by .nav--theme-scent in app.css. */
  }
  <a
    class="relative inline-flex after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-scent-tint after:content-[''] group-[.nav--theme-scent]:after:scale-x-100 motion-safe:after:[transition:transform_0.3s_var(--ease-power2-out)]"
    data-nav-logo
    href={withBase("/")}
    aria-label="osvant — home"
  >
    {
      /* Rive `logo` artboard placeholder: static SVG wordmark (06 §1).
        The fill and face are set in CSS, not as SVG presentation
        attributes: those cannot read a custom property, and font-stretch
        does not take a percentage as an attribute — which is exactly the
        descriptor that selects Mosvita's Expanded master (01 §3.1). */
    }
    <svg
      class="h-5 w-24 [&_text]:font-display [&_text]:font-black [&_text]:[font-stretch:125%]"
      viewBox="0 0 96 20"
      role="img"
      aria-hidden="true"
    >
      <text x="0" y="15">osvant</text>
    </svg>
  </a>

  {
    /* The menu button. 01 §5.2 specifies the overlay it opens but says
      nothing about the control — flagged as a spec gap and built to the
      existing register (1px rules, no chrome, currentColor so it
      re-themes with the links). It had no visual at all before this: the
      markup carried an empty bar span that nothing styled, so the button
      rendered 12x2px and invisible, and at every mobile width the site
      had no reachable navigation.

      44px is the tap-target floor (WCAG 2.5.5 / iOS HIG); the bars are
      22px and the rest is deliberate padding, not chrome. z-1 keeps it
      above the overlay it opens, which is `fixed inset-0`. */
  }
  <button
    class="relative -mr-2 hidden size-11 cursor-pointer items-center justify-center border-0 bg-none max-md:z-1 max-md:inline-flex"
    type="button"
    aria-expanded="false"
    aria-controls="nav-menu"
    data-nav-toggle
  >
    <span class="sr-only">Menu</span>
    {
      /* Three rules out of one span, so the markup stays as authored.
        Open: the middle rule goes and the outer two cross. */
    }
    <span
      class="relative block h-px w-[22px] bg-current before:absolute before:start-0 before:block before:h-px before:w-[22px] before:-translate-y-[7px] before:bg-current before:content-[''] after:absolute after:start-0 after:block after:h-px after:w-[22px] after:translate-y-[7px] after:bg-current after:content-[''] aria-expanded:bg-transparent motion-safe:[&,&::before,&::after]:[transition:transform_0.3s,background-color_0.3s]"
      aria-hidden="true"></span>
  </button>

  {
    /* Closed overlay stays out of the tab order and away from AT, hence
      `invisible` with a delayed visibility transition. */
  }
  <div
    id="nav-menu"
    class="flex items-center gap-10 max-md:invisible max-md:fixed max-md:inset-0 max-md:translate-x-full max-md:flex-col max-md:justify-center max-md:gap-8 max-md:bg-ink-1 max-md:[transition:transform_0.3s,visibility_0s_0.3s] max-md:data-[open=true]:visible max-md:data-[open=true]:translate-x-0 max-md:data-[open=true]:[transition:transform_0.3s,visibility_0s]"
    data-nav-menu
  >
    {
      /* 01 §5.2: "links at --text--h2". Setting it on the list did nothing
        — a rule on the anchor outranks an inherited value, so the overlay
        shipped at 16px. Invisible until the toggle became pressable. */
    }
    <ul
      class="nav__links flex list-none gap-8 max-md:flex-col max-md:items-center max-md:gap-6 [&_a]:text-base [&_a]:no-underline max-md:[&_a]:text-h2"
    >
      {
        links.map((link) => (
          <li>
            <a href={withBase(link.href)}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <button
      class="inline-flex cursor-pointer items-center gap-1.5 border-0 bg-none p-0 text-base max-md:text-h2"
      type="button"
      data-cart-open
      aria-label="Cart"
    >
      cart
      <span
        class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-amber px-1.5 text-xs text-black"
        data-cart-count>0</span
      >
    </button>
  </div>
</nav>
