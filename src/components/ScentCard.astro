---
// Scent card (01 §5.3) — collection grid + home showcase. Surface ink-2,
// radius xs; hover swaps border → --scent-tint (per scent via data-scent)
// and drifts the bottle render −8px (0.5s power2.out approx). Bottle
// stills are delivered and already carry the gallery and the PDP; the
// card still shows the tint wash until its interior is rebuilt around
// the render. Motion hook: data-anim="card" (stagger group).
import { withBase } from "../lib/url";

interface Props {
  scent: string;
  name: string; // e.g. "the volt" — article renders in serif italic
  batch: string;
  notes: string[];
  price: number;
  stagger?: number; // page-specific group stagger (03 §2: 0.05)
  /** Grid columns to span in an asymmetric editorial row (03 §2).
   * Lives here, not on the parent: a page-scoped `.grid > :nth-child()`
   * rule can never match a component root (review OSV-04). */
  span?: 1 | 2 | 3;
}

const { scent, name, batch, notes, price, stagger, span = 1 } = Astro.props;
const [article, ...rest] = name.split(" ");
---

<article
  class:list={[
    "group flex flex-col gap-4 rounded-sm border border-transparent bg-ink-2 p-6",
    /* 01 §5.3 hover — border goes to the scent tint, bottle drifts -8px. */
    "motion-safe:[transition:border-color_0.3s,transform_0.5s_var(--ease-expo-out)] motion-safe:focus-within:border-scent-tint motion-safe:hover:border-scent-tint",
    /* Asymmetric editorial rows (03 §2) — the card owns its own span,
       because a page-scoped `.grid > :nth-child()` rule can never match a
       component root (review OSV-04). Spelled out per branch: Tailwind's
       scanner cannot see a class name built by concatenation. */
    span === 2 && "col-span-2 max-md:col-auto",
    span === 3 && "col-span-full max-md:col-auto",
  ]}
  data-scent={scent}
  data-anim="card"
  data-stagger={stagger}
  data-span={span}
>
  <p class="eyebrow text-xs">batch {batch}</p>
  {
    /* The peak rung (01 §3.3): the accent word keeps the display cut and
      changes only its light. Under a scent scope that is the scent's own
      tint; at house level --scent-tint-text resolves to white. */
  }
  <h2 class="display text-3xl [&_em]:text-scent-tint-text [&_em]:not-italic">
    <em>{article}</em>{" "}
    {rest.join(" ")}
  </h2>

  {
    /* Scent-tinted wash, standing in for the bottle render. Bounded height
      rather than a bare aspect-ratio: once the asymmetric rows apply
      (review OSV-04) a span-2 card is ~950px wide, and 3/4 of that is a
      1266px-tall slab. Height still reserves its own space, so the CLS
      budget is unaffected (M §8.4). */
  }
  <div
    class="h-[clamp(11rem,18vw,18rem)] rounded-media bg-[radial-gradient(ellipse_70%_55%_at_50%_62%,color-mix(in_oklab,var(--scent-tint)_26%,transparent)_0%,transparent_75%)] motion-safe:[transition:transform_0.5s_var(--ease-expo-out)] motion-safe:group-focus-within:-translate-y-2 motion-safe:group-hover:-translate-y-2"
    aria-hidden="true"
  >
  </div>

  <ul class="flex list-none flex-wrap gap-x-3 gap-y-1.5 eyebrow text-xs">
    {notes.map((note) => <li>{note}</li>)}
  </ul>

  <div class="mt-auto flex items-center justify-between">
    <p class="text-xl">€{price}</p>
    <a
      class="text-base text-white no-underline"
      href={withBase(`collection/${scent}/`)}
    >
      <span data-btn-label>discover -&gt;</span>
    </a>
  </div>
</article>
