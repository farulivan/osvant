---
// Shared shell for the two legal routes (03 §7, review OSV-29). Short is
// fine for a demo store; empty is not — these were 12-word stubs linked
// from every page footer.
//
// The body is markdown, so its h2/p cannot carry classes; the `[&_h2]:`
// variants below replace what used to be a `:global()` escape hatch and
// keep the styling attached to the element that owns it.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section
  class="min-h-screen bg-black px-gutter pt-40 pb-24"
  data-nav-theme="dark"
  aria-labelledby="legal-title"
>
  <p class="mb-4 eyebrow text-xs" data-eyebrow>legal</p>
  <h1 class="display text-h1" id="legal-title" data-anim="split">
    {title}
  </h1>

  {
    /* The demo statement is the most load-bearing sentence on the page, so
      it is set above body size rather than buried at eyebrow scale. */
  }
  <p class="mt-6 max-w-[46ch] text-2xl text-white">
    osvant is a portfolio demonstration. it is not a real shop, no real orders
    are processed, and no payment is ever taken.
  </p>

  <div
    class="mt-10 max-w-[62ch] text-haze-2 [&_h2]:mt-10 [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_p]:mb-4 [&_p]:text-lg [&_p]:leading-relaxed"
  >
    <slot />
  </div>
</section>
