---
// Footer (01-design-system.md §5.6). Lives OUTSIDE [data-taxi] — persistent
// across navigations, same as Nav.astro.
import { withBase } from "../lib/url";

// `01 §5.6` calls the footer "a designed destination". It was four rows
// crammed into the left third with a void to the right, three unlabelled
// link lists, and no legal row at all (review OSV-22). The lists carry
// their own headings now, so a column says what it is.
const columns = [
  {
    label: "explore",
    external: false,
    links: [
      { href: "collection", label: "collection" },
      { href: "the-house", label: "the house" },
      { href: "journal", label: "journal" },
      { href: "contact", label: "contact" },
    ],
  },
  {
    label: "follow",
    external: true,
    links: [
      { href: "https://instagram.com", label: "instagram" },
      { href: "https://tiktok.com", label: "tiktok" },
      { href: "https://youtube.com", label: "youtube" },
      { href: "https://twitch.tv", label: "twitch" },
    ],
  },
  {
    label: "legal",
    external: false,
    links: [
      { href: "legal/privacy", label: "privacy" },
      { href: "legal/terms", label: "terms" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer" data-nav-theme="dark">
  <div class="footer__marquee display" aria-hidden="true" data-anim="marquee">
    <span>provocation, bottled. &nbsp;</span>
    <span>provocation, bottled. &nbsp;</span>
  </div>

  <div class="footer__newsletter">
    <p class="footer__newsletter-label display">join the current</p>
    <p class="footer__newsletter-lede">
      batch drops and nothing else — roughly six times a year.
    </p>
    <form class="footer__newsletter-form" data-newsletter-form>
      <label class="visually-hidden" for="newsletter-email">Email</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        placeholder="your email"
        required
      />
      <button class="btn-primary" type="submit">
        <span data-btn-label>join</span>
      </button>
      <p
        class="newsletter-msg eyebrow"
        data-newsletter-msg
        role="status"
        hidden
      >
      </p>
    </form>
    <p class="footer__newsletter-success" data-newsletter-success hidden>
      you&rsquo;re in the current.
      <span class="footer__newsletter-demo eyebrow"
        >demo — no list connected.</span
      >
    </p>
  </div>

  <div class="footer__rows">
    {
      columns.map((column) => (
        <nav class="footer__column" aria-label={column.label}>
          <p class="footer__column-label eyebrow">{column.label}</p>
          <ul class="footer__list">
            {column.links.map((item) => (
              <li>
                {column.external ? (
                  <a href={item.href} target="_blank" rel="noreferrer">
                    {item.label}
                  </a>
                ) : (
                  <a href={withBase(item.href)}>{item.label}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <p class="footer__legal eyebrow">
    <span>&copy; {year} osvant</span>
    <span class="footer__legal-sep" aria-hidden="true">·</span>
    <span>a portfolio demonstration — no real orders are taken.</span>
  </p>

  <p class="footer__wordmark display" aria-hidden="true">osvant</p>
</footer>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .footer {
    background: var(--color--black);
    color: var(--color--white);
    padding: 6rem var(--gutter) 0;
    overflow: hidden;
  }

  /* Ghost type (marquee + wordmark): 01 §5.6 specifies no color — gap
     flagged. ink-2 on black fails WCAG 1.4.3 (1.63:1); this haze-3 mix
     keeps the ghosted look at ~4:1 (≥3:1 large-text floor). */
  .footer__marquee {
    display: flex;

    /* The track is `width: max-content` and animates on x, so without
       this it pushes the document's scrollWidth past the viewport and
       every page gains a horizontal scrollbar on mobile — measured at
       +235px on /journal/ at 390px. The campaign marquee always clipped;
       this one never did. */
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--text--impact);
    color: color-mix(in oklab, var(--color--haze-3) 60%, var(--color--black));
  }

  /* The site's secondary conversion. It sat at the same weight as a
     sitemap link; it now leads the footer at display scale and spans the
     full width instead of being boxed into the left third. */
  .footer__newsletter {
    margin-top: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color--ink-3);
  }

  .footer__newsletter-label {
    margin: 0;
    font-size: var(--text--h3);
  }

  .footer__newsletter-lede {
    margin: var(--space--2xs) 0 var(--space--s);
    max-width: 36ch;
    font-size: var(--text--h6);
    color: var(--color--haze-2);
  }

  .footer__newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 34rem;
    overflow: hidden;
  }

  /* 01 §5.5 — validation copy at eyebrow size, amber, below the field */
  .newsletter-msg {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    font-size: var(--text--eyebrow);
  }

  .newsletter-msg--error {
    color: var(--color--amber);
  }

  .footer__newsletter-success {
    margin: 0.5rem 0 0;
    font-size: var(--text--h4);
  }

  .footer__newsletter-demo {
    display: block;
    margin-top: 0.25rem;
    font-family: inherit;
    font-size: var(--text--eyebrow);
    font-style: normal;
  }

  .footer__newsletter-form input {
    flex: 1;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color--ink-4);
    border-radius: 0;
    color: var(--color--white);
    padding: 0.5rem 0;
    font-size: var(--text--body);
  }

  .footer__newsletter-form input:focus-visible {
    border-bottom-color: var(--color--phosphor);
  }

  /* Three columns across the full width, rather than three lists stacked
     into the left third with a void beside them. */
  .footer__rows {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: 3rem;
    font-size: var(--text--h6);
  }

  .footer__column-label {
    margin: 0 0 var(--space--xs);
    font-size: var(--text--eyebrow);
  }

  /* The legal row the footer never had (01 §5.6, review OSV-22). */
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space--2xs) var(--space--xs);
    margin: 3rem 0 0;
    padding-top: var(--space--s);
    border-top: 1px solid var(--color--ink-3);
    font-size: var(--text--eyebrow);

    /* haze-3, not ink-4. `01 §6.2` scopes ink-4 to operable elements at
       the 3:1 non-text floor; this is small text and needs 4.5:1. */
  }

  .footer__legal-sep {
    color: var(--color--ink-3);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__list a {
    color: var(--color--haze-3);
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--color--white);
  }

  /* The one sanctioned departure from the §3.2 scale and from .display's
     line-height: this is a graphic element, not a heading (01 §3.3). */
  .footer__wordmark {
    margin: 3rem 0 0;
    font-size: clamp(6rem, 20vw, 16rem);
    line-height: 0.8;
    color: color-mix(in oklab, var(--color--haze-3) 60%, var(--color--black));
    transform: translateY(20%);
  }

  @media (width <= 47.9375rem) {
    .footer__rows {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      row-gap: var(--space--l);
    }
  }

  @media (width <= 29.9375rem) {
    .footer__rows {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
