---
// Footer (01-design-system.md §5.6). Lives OUTSIDE [data-taxi] — persistent
// across navigations, same as Nav.astro.
import { withBase } from "../lib/url";

// `01 §5.6` calls the footer "a designed destination". It was four rows
// crammed into the left third with a void to the right, three unlabelled
// link lists, and no legal row at all (review OSV-22). The lists carry
// their own headings now, so a column says what it is.
const columns = [
  {
    label: "explore",
    external: false,
    links: [
      { href: "collection", label: "collection" },
      { href: "the-house", label: "the house" },
      { href: "journal", label: "journal" },
      { href: "contact", label: "contact" },
    ],
  },
  {
    label: "follow",
    external: true,
    links: [
      { href: "https://instagram.com", label: "instagram" },
      { href: "https://tiktok.com", label: "tiktok" },
      { href: "https://youtube.com", label: "youtube" },
      { href: "https://twitch.tv", label: "twitch" },
    ],
  },
  {
    label: "legal",
    external: false,
    links: [
      { href: "legal/privacy", label: "privacy" },
      { href: "legal/terms", label: "terms" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer
  class="overflow-hidden bg-black px-gutter pt-24 text-white"
  data-nav-theme="dark"
>
  {
    /* overflow-hidden is load-bearing: the track is `w-max` and animates on
      x, so without it the document's scrollWidth passes the viewport and
      every page gains a horizontal scrollbar on mobile — measured at
      +235px on /journal/ at 390px. The campaign marquee always clipped;
      this one never did. */
  }
  <div
    class="flex overflow-hidden display text-impact whitespace-nowrap text-ghost"
    aria-hidden="true"
    data-anim="marquee"
  >
    <span>provocation, bottled. &nbsp;</span>
    <span>provocation, bottled. &nbsp;</span>
  </div>

  {
    /* The site's secondary conversion. It sat at the same weight as a
      sitemap link; it leads the footer at display scale now and spans the
      full width instead of being boxed into the left third. */
  }
  <div class="mt-16 border-b border-b-ink-3 pb-12">
    <p class="display text-3xl">join the current</p>
    <p class="mt-2 mb-6 max-w-[36ch] text-base text-haze-2">
      batch drops and nothing else — roughly six times a year.
    </p>
    <form
      class="flex max-w-[34rem] flex-wrap gap-4 overflow-hidden"
      data-newsletter-form
    >
      <label class="sr-only" for="newsletter-email">Email</label>
      <input
        id="newsletter-email"
        class="flex-1 rounded-none border-0 border-b border-b-ink-4 bg-transparent py-2 text-lg text-white focus-visible:border-b-phosphor"
        name="email"
        type="email"
        placeholder="your email"
        required
      />
      <button class="btn-primary" type="submit">
        <span data-btn-label>join</span>
      </button>
      <p
        class="newsletter-msg eyebrow"
        data-newsletter-msg
        role="status"
        hidden
      >
      </p>
    </form>
    <p class="mt-2 text-2xl" data-newsletter-success hidden>
      you&rsquo;re in the current.
      <span class="mt-1 block eyebrow font-[inherit] text-xs not-italic"
        >demo — no list connected.</span
      >
    </p>
  </div>

  {
    /* Three columns across the full width, rather than three lists stacked
      into the left third with a void beside them (review OSV-22). */
  }
  <div
    class="mt-12 grid grid-cols-3 gap-5 text-base max-md:grid-cols-2 max-md:gap-y-16 max-tiny:grid-cols-1"
  >
    {
      columns.map((column) => (
        <nav aria-label={column.label}>
          <p class="mb-4 eyebrow text-xs">{column.label}</p>
          <ul class="flex list-none flex-col gap-3 [&_a]:text-haze-3 [&_a]:no-underline [&_a:hover]:text-white">
            {column.links.map((item) => (
              <li>
                {column.external ? (
                  <a href={item.href} target="_blank" rel="noreferrer">
                    {item.label}
                  </a>
                ) : (
                  <a href={withBase(item.href)}>{item.label}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  {
    /* The legal row the footer never had (01 §5.6, review OSV-22). haze-3
      via .eyebrow, not ink-4: 01 §6.2 scopes ink-4 to operable elements at
      the 3:1 non-text floor, and this is small text needing 4.5:1. */
  }
  <p
    class="mt-12 flex flex-wrap gap-x-4 gap-y-2 border-t border-t-ink-3 pt-6 eyebrow text-xs"
  >
    <span>&copy; {year} osvant</span>
    <span class="text-ink-3" aria-hidden="true">·</span>
    <span>a portfolio demonstration — no real orders are taken.</span>
  </p>

  {
    /* The one sanctioned departure from the §3.2 scale and from .display's
      line-height: this is a graphic element, not a heading (01 §3.3). */
  }
  <p
    class="mt-12 translate-y-[20%] display text-[clamp(6rem,20vw,16rem)] leading-[0.8] text-ghost"
    aria-hidden="true"
  >
    osvant
  </p>
</footer>
