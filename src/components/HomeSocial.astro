---
// Social band (03 §1.6). Title fragments split-reveal per M §4.2; four
// link cards with hover tilt — micro register (0.25s), max 3° (spec cap),
// CSS-only, gated to no-preference.
---

<section
  class="bg-black px-gutter py-24"
  data-nav-theme="dark"
  aria-labelledby="social-title"
>
  <p class="mb-4 eyebrow text-xs" data-eyebrow>what's diffusing</p>
  <h2 class="mb-12 display text-h1" id="social-title">
    <span class="block" data-anim="split">@osvant</span>
    <span class="block" data-anim="split">everywhere</span>
  </h2>

  {
    /* Tiny (<=479px): two-up leaves a 140px tile, smaller than the card's
      own padding budget (review OSV-13). */
  }
  <ul
    class="grid list-none grid-cols-4 gap-5 max-lg:grid-cols-2 max-md:grid-cols-2 max-tiny:grid-cols-1"
  >
    {
      [
        { label: "tiktok", href: "https://tiktok.com" },
        { label: "instagram", href: "https://instagram.com" },
        { label: "youtube", href: "https://youtube.com" },
        { label: "twitch", href: "https://twitch.tv" },
      ].map((item, index) => (
        <li>
          <a
            class:list={[
              "flex flex-col gap-1 rounded-sm border border-transparent bg-ink-2 p-6 text-white no-underline motion-safe:[transition:transform_0.25s_var(--ease-power2-out),border-color_0.25s] motion-safe:hover:-translate-y-1 motion-safe:hover:border-scent-tint motion-safe:focus-visible:-translate-y-1 motion-safe:focus-visible:border-scent-tint",
              /* hover tilt — micro register, max 3deg (03 §1.6). Alternating
                 the direction makes the row read as scattered polaroids
                 rather than a rank. Both strings are written out in full:
                 a concatenated class name is invisible to Tailwind's
                 source scanner and would silently never be generated. */
              index % 2 === 0
                ? "motion-safe:hover:rotate-[-1.5deg] motion-safe:focus-visible:rotate-[-1.5deg]"
                : "motion-safe:hover:rotate-[1.5deg] motion-safe:focus-visible:rotate-[1.5deg]",
            ]}
            href={item.href}
            target="_blank"
            rel="noreferrer"
          >
            <span class="display text-xl">{item.label}</span>
            <span class="eyebrow text-xs">@osvant</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
