---
// Campaign band — featured drop (03 §1.5). Full-bleed ink-1; marquee per
// M §4.7 (data-anim="marquee", velocity-reactive, pauses off-viewport);
// amber appears ONLY in its canonical role here — the limited chip
// (01 §1 rule 4, RFC-001 A3). The still grades to --scent-tint rather
// than the house green: the band is scoped to fever, and an ember plate
// pushed green throws away the only reason it works.
import { withBase } from "../lib/url";
import Duotone from "./Duotone.astro";
import { campaign } from "../lib/photos";
import { catalog } from "../lib/commerce";

const fever = catalog.find((product) => product.scent === "fever");
---

<section
  class="campaign"
  data-nav-theme="dark"
  data-scent="fever"
  aria-labelledby="campaign-title"
>
  <div class="campaign__marquee" aria-hidden="true">
    <div class="campaign__marquee-track display" data-anim="marquee">
      <span>fever — limited batch 001 &nbsp;·&nbsp; </span>
    </div>
  </div>

  <div class="campaign__body">
    <Duotone
      class="campaign__media"
      image={campaign.hero.image}
      alt=""
      widths={[560, 900, 1400]}
      sizes="(width <= 47.9375rem) 100vw, 50vw"
      tint={campaign.hero.tint}
      exposure={campaign.hero.exposure}
    />

    <div class="campaign__content">
      <p class="campaign__eyebrow eyebrow" data-eyebrow>
        batch 001 — the featured drop
      </p>
      <h2 class="campaign__title display" id="campaign-title" data-anim="split">
        the fever
      </h2>
      <p class="campaign__lead">
        saffron, chili-rose, benzoin. the heat, bottled.
      </p>

      <div class="campaign__buy">
        <p class="campaign__price display">€{fever?.variants[0].price}</p>
        <span class="campaign__chip eyebrow">limited</span>
      </div>

      <a class="btn-primary" href={withBase("collection/fever/")}>
        <span data-btn-label>shop fever</span>
      </a>
    </div>
  </div>
</section>

<style>
  .campaign {
    background: var(--color--ink-1);
    overflow: hidden;
  }

  .campaign__marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--color--ink-3);
    padding-block: 0.75rem;
  }

  .campaign__marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    font-size: var(--text--h3);
    will-change: transform;
  }

  .campaign__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    align-items: center;
    padding: 4rem var(--gutter);
  }

  .campaign__body :global(.campaign__media) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius--media);
  }

  .campaign__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
  }

  .campaign__title {
    margin: 0 0 var(--space--headline-lede);
    font-size: var(--text--h2);
  }

  /* Price and scarcity chip together — the home page previously showed no
     price anywhere at all (review OSV-20). */
  .campaign__buy {
    display: flex;
    align-items: center;
    gap: var(--space--s);
    margin: var(--space--lede-content) 0 var(--space--s);
  }

  .campaign__price {
    margin: 0;
    font-size: var(--text--med);
  }

  .campaign__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  /* Amber canonical role: scarcity chip only (01 §1 rule 4) */
  .campaign__chip {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color--amber);
    border-radius: var(--radius--xs);
    color: var(--color--amber);
    font-size: var(--text--eyebrow);
  }

  .campaign__lead {
    margin: 0;
    font-size: var(--text--lead);
    max-width: 24ch;
  }

  @media (width <= 47.9375rem) {
    .campaign__body {
      grid-template-columns: 1fr;
    }
  }
</style>
