---
// Campaign band — featured drop (03 §1.5). Full-bleed ink-1; marquee per
// M §4.7 (data-anim="marquee", velocity-reactive, pauses off-viewport);
// amber appears ONLY in its canonical role here — the limited chip
// (01 §1 rule 4, RFC-001 A3). The still grades to --scent-tint rather
// than the house green: the band is scoped to fever, and an ember plate
// pushed green throws away the only reason it works.
import { withBase } from "../lib/url";
import Duotone from "./Duotone.astro";
import { campaign } from "../lib/photos";
import { catalog } from "../lib/commerce";

const fever = catalog.find((product) => product.scent === "fever");
---

<section
  class="overflow-hidden bg-ink-1"
  data-nav-theme="dark"
  data-scent="fever"
  aria-labelledby="campaign-title"
>
  <div class="overflow-hidden border-b border-b-ink-3 py-3" aria-hidden="true">
    <div
      class="flex w-max display text-3xl whitespace-nowrap will-change-transform"
      data-anim="marquee"
    >
      <span>fever — limited batch 001 &nbsp;·&nbsp; </span>
    </div>
  </div>

  <div
    class="grid grid-cols-2 items-center gap-5 px-gutter py-16 max-md:grid-cols-1"
  >
    <Duotone
      class="aspect-4/3 rounded-media"
      image={campaign.hero.image}
      alt=""
      widths={[560, 900, 1400]}
      sizes="(width <= 47.9375rem) 100vw, 50vw"
      tint={campaign.hero.tint}
      exposure={campaign.hero.exposure}
    />

    <div class="flex flex-col items-start gap-6">
      <p class="mb-4 eyebrow text-xs" data-eyebrow>
        batch 001 — the featured drop
      </p>
      <h2 class="mb-6 display text-h2" id="campaign-title" data-anim="split">
        the fever
      </h2>
      <p class="max-w-[24ch] text-2xl">
        saffron, chili-rose, benzoin. the heat, bottled.
      </p>

      {
        /* Price and scarcity chip together — the home page previously showed
          no price anywhere at all (review OSV-20). */
      }
      <div class="mt-10 mb-6 flex items-center gap-6">
        <p class="display text-5xl">€{fever?.variants[0].price}</p>
        {/* Amber canonical role: scarcity chip only (01 §1 rule 4) */}
        <span
          class="rounded-sm border border-amber px-3 py-1.5 eyebrow text-xs text-amber"
          >limited</span
        >
      </div>

      <a class="btn-primary" href={withBase("collection/fever/")}>
        <span data-btn-label>shop fever</span>
      </a>
    </div>
  </div>
</section>
