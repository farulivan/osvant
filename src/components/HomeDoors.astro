---
// Two-door split — the lab / the cult (03 §1.3). Entire door is the hit
// area; titles are stacked fragments, each revealing independently via the
// split module (M §4.2). Hover (media scale 1.05 0.6s, title x-shift 0.5em,
// arrow appears) is pure CSS, disabled under reduced motion.
//
// Door media is duotone-graded at runtime (01 §6) with a bottom-up scrim
// so the type always has a ground — the plates are busy edge to edge, so
// the scrim is load-bearing here rather than a nicety.
import { withBase } from "../lib/url";
import Duotone from "./Duotone.astro";
import { doors as doorPhotos } from "../lib/photos";

// 03 §1.3 — each door carries an eyebrow and a one-line description.
// Four words over a gradient gave a visitor no reason to click and no
// idea where they led (review OSV-24).
const doors = [
  {
    href: "the-house/",
    eyebrow: "craft",
    fragments: ["the", "lab"],
    line: "six weeks of maceration, thirty-one materials, one bench.",
    photo: doorPhotos.lab,
  },
  {
    href: "journal/",
    eyebrow: "culture",
    fragments: ["the", "cult"],
    line: "transmissions from the people already wearing it.",
    photo: doorPhotos.cult,
  },
];
// The M §2 pair for the door hover: 0.6s transform (UI move register),
// 0.3s opacity (micro). Written out rather than a single `duration-*`,
// which would push the opacity fade out of its register.
const TRANSITION =
  "motion-safe:[transition:transform_0.6s_var(--ease-power2-out),opacity_0.3s_var(--ease-power2-out)]";
---

<section
  class="relative z-1 bg-black"
  id="doors"
  aria-label="the lab and the cult"
  data-nav-theme="dark"
>
  {
    doors.map((door) => (
      <a
        class="group relative flex min-h-[60vh] items-end overflow-hidden border-b border-b-ink-3 p-gutter text-white no-underline"
        href={withBase(door.href)}
      >
        <Duotone
          class={`pointer-events-none absolute inset-0 ${TRANSITION} motion-safe:group-hover:scale-105 motion-safe:group-focus-visible:scale-105`}
          image={door.photo.image}
          alt=""
          widths={[720, 1280, 1920]}
          sizes="100vw"
          exposure={door.photo.exposure}
        />
        {/* Bottom-up scrim — the plates are busy across the whole frame, so
            white impact type needs a ground to sit on (review §7). */}
        <span
          class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,var(--color--black)_0%,color-mix(in_oklab,var(--color--black)_70%,transparent)_34%,transparent_68%)]"
          aria-hidden="true"
        />
        <div class="relative flex flex-col">
          <p class="mb-4 eyebrow text-xs" data-eyebrow>
            {door.eyebrow}
          </p>
          <h2
            class={`relative display text-h1 ${TRANSITION} motion-safe:group-hover:translate-x-[0.5em] motion-safe:group-focus-visible:translate-x-[0.5em]`}
          >
            {door.fragments.map((fragment) => (
              <span class="block" data-anim="split">
                {fragment}
              </span>
            ))}
          </h2>
          <p class="mt-6 max-w-[34ch] text-base text-haze-2">{door.line}</p>
        </div>
        <span
          class={`relative ml-auto self-end text-3xl opacity-0 ${TRANSITION} motion-safe:group-hover:opacity-100 motion-safe:group-focus-visible:opacity-100`}
          aria-hidden="true"
        >
          -&gt;
        </span>
      </a>
    ))
  }
</section>
