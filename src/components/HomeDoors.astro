---
// Two-door split — the lab / the cult (03 §1.3). Entire door is the hit
// area; titles are stacked fragments, each revealing independently via the
// split module (M §4.2). Hover (media scale 1.05 0.6s, title x-shift 0.5em,
// arrow appears) is pure CSS, disabled under reduced motion.
//
// Imagery (macro ingredients / campaign photography) is pending assets
// (06 §1) — [data-door-media] is a duotone placeholder wash (ADR-008) and
// gets data-anim="parallax" (M §4.5) when real media lands.
import { withBase } from "../lib/url";
---

<section
  class="doors"
  id="doors"
  aria-label="the lab and the cult"
  data-nav-theme="dark"
>
  <a class="door" href={withBase("the-house/")}>
    <div class="door__media door__media--lab" aria-hidden="true"></div>
    <h2 class="door__title">
      <span class="door__fragment" data-anim="split">the</span>
      <span class="door__fragment" data-anim="split">lab</span>
    </h2>
    <span class="door__arrow" aria-hidden="true">-&gt;</span>
  </a>

  <a class="door" href={withBase("journal/")}>
    <div class="door__media door__media--cult" aria-hidden="true"></div>
    <h2 class="door__title">
      <span class="door__fragment" data-anim="split">the</span>
      <span class="door__fragment" data-anim="split">cult</span>
    </h2>
    <span class="door__arrow" aria-hidden="true">-&gt;</span>
  </a>
</section>

<style>
  .doors {
    position: relative;
    z-index: 1; /* slides over the dimming hero (M §4.10) */
    background: var(--color--black);
  }

  .door {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 70vh;
    padding: var(--gutter);
    overflow: hidden;
    text-decoration: none;
    color: var(--color--white);
    border-bottom: 1px solid var(--color--ink-3);
  }

  .door__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Duotone placeholders pending photography (ADR-008) */
  .door__media--lab {
    background: linear-gradient(
      160deg,
      var(--color--ink-1) 0%,
      color-mix(in oklab, var(--color--uv) 22%, var(--color--ink-1)) 100%
    );
  }

  .door__media--cult {
    background: linear-gradient(
      200deg,
      var(--color--ink-1) 0%,
      color-mix(in oklab, var(--color--lilac-2) 18%, var(--color--ink-1)) 100%
    );
  }

  .door__title {
    position: relative;
    margin: 0;
    font-size: var(--text--h1);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1.05;
  }

  .door__fragment {
    display: block;
  }

  .door__arrow {
    position: relative;
    align-self: flex-end;
    margin-left: auto;
    font-size: var(--text--h3);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .door__media,
    .door__title,
    .door__arrow {
      transition:
        transform 0.6s,
        opacity 0.3s;
      transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .door:hover .door__media,
    .door:focus-visible .door__media {
      transform: scale(1.05);
    }

    .door:hover .door__title,
    .door:focus-visible .door__title {
      transform: translateX(0.5em);
    }

    .door:hover .door__arrow,
    .door:focus-visible .door__arrow {
      opacity: 1;
    }
  }
</style>
