---
// Two-door split — the lab / the cult (03 §1.3). Entire door is the hit
// area; titles are stacked fragments, each revealing independently via the
// split module (M §4.2). Hover (media scale 1.05 0.6s, title x-shift 0.5em,
// arrow appears) is pure CSS, disabled under reduced motion.
//
// Door plates are delivered (photo/doors/the-lab.jpg, the-cult.jpg);
// [data-door-media] still shows a duotone wash until they are wired in,
// and gains data-anim="parallax" (M §4.5) at the same time.
import { withBase } from "../lib/url";

// 03 §1.3 — each door carries an eyebrow and a one-line description.
// Four words over a gradient gave a visitor no reason to click and no
// idea where they led (review OSV-24).
const doors = [
  {
    href: "the-house/",
    eyebrow: "craft",
    fragments: ["the", "lab"],
    line: "six weeks of maceration, thirty-one materials, one bench.",
    media: "lab",
  },
  {
    href: "journal/",
    eyebrow: "culture",
    fragments: ["the", "cult"],
    line: "transmissions from the people already wearing it.",
    media: "cult",
  },
];
---

<section
  class="doors"
  id="doors"
  aria-label="the lab and the cult"
  data-nav-theme="dark"
>
  {
    doors.map((door) => (
      <a class="door" href={withBase(door.href)}>
        <div
          class={`door__media door__media--${door.media}`}
          aria-hidden="true"
        />
        <div class="door__body">
          <p class="door__eyebrow" data-eyebrow>
            {door.eyebrow}
          </p>
          <h2 class="door__title">
            {door.fragments.map((fragment) => (
              <span class="door__fragment" data-anim="split">
                {fragment}
              </span>
            ))}
          </h2>
          <p class="door__line">{door.line}</p>
        </div>
        <span class="door__arrow" aria-hidden="true">
          -&gt;
        </span>
      </a>
    ))
  }
</section>

<style>
  .doors {
    position: relative;
    z-index: 1; /* slides over the dimming hero (M §4.10) */
    background: var(--color--black);
  }

  .door {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 70vh;
    padding: var(--gutter);
    overflow: hidden;
    text-decoration: none;
    color: var(--color--white);
    border-bottom: 1px solid var(--color--ink-3);
  }

  .door__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Duotone washes — the delivered plates are wired in the next PR. */
  .door__media--lab {
    background: linear-gradient(
      160deg,
      var(--color--ink-1) 0%,
      color-mix(in oklab, var(--color--uv) 22%, var(--color--ink-1)) 100%
    );
  }

  .door__media--cult {
    background: linear-gradient(
      200deg,
      var(--color--ink-1) 0%,
      color-mix(in oklab, var(--color--lilac-2) 18%, var(--color--ink-1)) 100%
    );
  }

  .door__body {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .door__eyebrow {
    margin: 0 0 var(--space--eyebrow-headline);
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .door__line {
    margin: var(--space--headline-lede) 0 0;
    max-width: 34ch;
    font-size: var(--text--h6);
    color: var(--color--lilac-2);
  }

  .door__title {
    position: relative;
    margin: 0;
    font-size: var(--text--h1);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1.05;
  }

  .door__fragment {
    display: block;
  }

  .door__arrow {
    position: relative;
    align-self: flex-end;
    margin-left: auto;
    font-size: var(--text--h3);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .door__media,
    .door__title,
    .door__arrow {
      transition:
        transform 0.6s,
        opacity 0.3s;
      transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .door:hover .door__media,
    .door:focus-visible .door__media {
      transform: scale(1.05);
    }

    .door:hover .door__title,
    .door:focus-visible .door__title {
      transform: translateX(0.5em);
    }

    .door:hover .door__arrow,
    .door:focus-visible .door__arrow {
      opacity: 1;
    }
  }
</style>
