---
// Placeholder section for routes whose content lands in M2. Every section
// on every page must declare `data-nav-theme` (03 §sitemap, M §4.9) — this
// keeps stub routes review-compliant until real content replaces them.
interface Props {
  eyebrow: string;
  title: string;
  theme?: "dark" | "light" | "scent";
}

const { eyebrow, title, theme = "dark" } = Astro.props;
---

<section class="stub" data-nav-theme={theme}>
  <p class="stub__eyebrow">{eyebrow}</p>
  <h1 class="stub__title">{title}</h1>
  <p class="stub__note">
    Content lands in M2 — this route is wired, not yet built.
  </p>
</section>

<style>
  .stub {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
    min-height: 100vh;
    padding: 0 var(--gutter);
  }

  .stub__eyebrow {
    font-size: var(--text--eyebrow);
    color: var(--color--lilac-3);
    margin: 0;
  }

  .stub__title {
    font-size: var(--text--impact);
    margin: 0;
  }

  .stub__note {
    color: var(--color--lilac-3);
    font-size: var(--text--body);
    margin: 0;
  }
</style>
