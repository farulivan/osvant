---
// Home collection gallery — the signature moment (03 §1.4, M §4.4).
//
// Rebuilt on the light study (M §8, ADR-013): a pinned, scroll-scrubbed
// horizontal procession of five composited stills. No canvas, no camera —
// depth is differential parallax between the layers inside each stage.
//
// The overlay carries scent name, three notes, price and `discover`
// (03 §1.4). It previously carried only a name, which left the home page
// with no price or product information anywhere on it (review OSV-09/20),
// and the section had no `h2` at all, so the signature moment was
// invisible to search and to screen readers.
//
// Type safe zone: the overlay owns the left 38% of the stage and the
// track is inset to match, so no bottle can enter it at any scrub
// position — by layout, not by a scrim (M §4.4, review OSV-10).
//
// Nothing here is eager. The gallery sits below the hero, and giving its
// first bottle fetchpriority="high" took bandwidth from the hero h1 —
// which M §10 requires to be the LCP element.
import LightStudy from "./LightStudy.astro";
import { withBase } from "../lib/url";
import { getProducts, summaryNotes } from "../lib/commerce";
import { stillFor } from "../lib/stills";

const scents = await getProducts();
---

<section
  class="bg-black"
  data-module="gallery"
  data-nav-theme="scent"
  data-scent={scents[0]?.scent}
  aria-labelledby="gallery-title"
>
  <div class="relative h-svh overflow-hidden" data-gallery-stage>
    <div
      class="absolute inset-y-0 right-auto left-[38%] flex w-max items-center gap-[6vw] px-[6vw] will-change-transform"
      data-gallery-track
      aria-hidden="true"
    >
      {
        scents.map((scent) => (
          <div
            class="w-[min(34vw,26rem)] flex-none"
            data-gallery-item
            data-scent={scent.scent}
            data-name={scent.name}
            data-notes={summaryNotes(scent).join("|")}
            data-price={`€${scent.variants[0].price}`}
            data-href={withBase(`collection/${scent.scent}/`)}
          >
            <LightStudy
              scent={scent.scent}
              alt=""
              image={stillFor(scent.scent)}
              width={720}
            />
          </div>
        ))
      }
    </div>

    <div
      class="absolute inset-y-0 left-0 z-1 flex w-[38%] flex-col items-start justify-center gap-5 px-gutter"
    >
      <p class="eyebrow text-xs" data-eyebrow>the collection</p>

      {/* Stacked fragments — restores parity beat 4 (M §11) */}
      <h2 class="flex flex-col display text-h2" id="gallery-title">
        <span data-anim="split">five</span>
        <span data-anim="split">currents</span>
      </h2>

      <div class="flex flex-col gap-2" aria-live="polite">
        <p class="overflow-hidden text-3xl leading-tight" data-gallery-name>
          {scents[0]?.name}
        </p>
        <ul
          class="flex list-none flex-wrap gap-x-3 gap-y-1 text-base text-haze-2 [&_li+li]:before:text-haze-3 [&_li+li]:before:content-['·_']"
          data-gallery-notes
        >
          {scents[0] && summaryNotes(scents[0]).map((note) => <li>{note}</li>)}
        </ul>
        <p class="text-xl" data-gallery-price>
          €{scents[0]?.variants[0].price}
        </p>
      </div>

      <a
        class="btn-secondary"
        data-gallery-discover
        href={withBase(`collection/${scents[0]?.scent}/`)}
      >
        <span data-btn-label>discover -&gt;</span>
      </a>
    </div>
  </div>

  {
    /* Reduced motion (M §9): no pin, no scrub — the procession lays out
      as a static row with every scent readable. The module swaps to this. */
  }
  <ul
    class="grid list-none grid-cols-[repeat(auto-fit,minmax(11rem,1fr))] gap-10 px-gutter py-24"
    data-gallery-static
    hidden
  >
    {
      scents.map((scent) => (
        <li class="flex flex-col items-start gap-2" data-scent={scent.scent}>
          <LightStudy
            scent={scent.scent}
            alt={`the ${scent.scent} bottle`}
            image={stillFor(scent.scent)}
            width={420}
          />
          <p class="mt-2 text-2xl">{scent.name}</p>
          <p class="eyebrow text-xs">{summaryNotes(scent).join(" · ")}</p>
          <a class="btn-text" href={withBase(`collection/${scent.scent}/`)}>
            <span data-btn-label>€{scent.variants[0].price} — discover</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
