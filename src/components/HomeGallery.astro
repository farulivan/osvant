---
// Home collection gallery (03 §1.4, M §4.4).
//
// INTERIM (ADR-013): the Three.js procession is deleted. The light study
// (M §8) rebuilds this section as a pinned track of five composited
// stills; until then the honest placeholder is the static 5-up
// procession, which already carries the section's information
// architecture. Entrance rides the shared card behaviour (M §4.3) so the
// section still declares a motion behaviour (M §0.1).
//
// Everything still missing here is tracked: no h2 (OSV-09), no notes or
// price in the overlay (OSV-09/20).
import { withBase } from "../lib/url";
import { getProducts } from "../lib/commerce";

const scents = await getProducts();
---

<section
  class="home-gallery"
  data-nav-theme="scent"
  data-scent={scents[0]?.scent}
  aria-label="the collection — five currents"
>
  <p class="home-gallery__eyebrow" data-eyebrow>the collection</p>

  <ul class="home-gallery__procession">
    {
      scents.map((scent) => (
        <li
          class="home-gallery__item"
          data-scent={scent.scent}
          data-anim="card"
        >
          <div class="home-gallery__media" aria-hidden="true" />
          <p class="home-gallery__name">{scent.name}</p>
          <a class="btn-text" href={withBase(`collection/${scent.scent}/`)}>
            discover
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .home-gallery {
    padding: 10rem var(--gutter);
    background: var(--color--black);
  }

  .home-gallery__eyebrow {
    margin: 0;
    font-size: var(--text--eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color--lilac-3);
  }

  .home-gallery__procession {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .home-gallery__item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .home-gallery__media {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: color-mix(in oklab, var(--scent-tint) 20%, var(--color--ink-1));
  }

  .home-gallery__name {
    margin: 0;
    font-family: var(--font--serif);
    font-size: var(--text--h3);
    font-style: italic;
    color: var(--scent-tint);
  }
</style>
