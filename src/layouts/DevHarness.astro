---
// Dev-harness shell (guide task 1.9, 06-asset-pipeline §2). Engineering
// tooling, not site chrome: no nav/footer/router, `noindex` always.
// Renders content only in `astro dev` (import.meta.env.DEV) or when the
// build sets PUBLIC_DEV_HARNESS=true (staging/preview CI per 05 §1) —
// production builds get the disabled notice, not the tools.
import "../styles/app.css";
import { Font } from "astro:assets";

interface Props {
  title: string;
  spec: string;
}

const { title, spec } = Astro.props;
const enabled =
  import.meta.env.DEV || import.meta.env.PUBLIC_DEV_HARNESS === "true";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    {
      /* The harness renders real components, so it needs the real face —
        --font--mosvita is undefined without this and every rule falls back. */
    }
    <Font cssVariable="--font--mosvita" />
    <title>{title} — osvant dev</title>
  </head>
  <body>
    <main class="flex flex-col gap-12 px-gutter py-16">
      <header class="harness__header">
        <p class="text-xs text-haze-3">dev harness · {spec}</p>
        <h1 class="harness__title display">{title}</h1>
      </header>
      {
        enabled ? (
          <slot />
        ) : (
          <p class="text-lg text-haze-3">
            disabled in this build — run `pnpm dev`, or set
            PUBLIC_DEV_HARNESS=true for staging/preview builds (05 §1)
          </p>
        )
      }
    </main>
  </body>
</html>
