---
// Base shell (01-arch §7): head/meta, nav, taxi container, footer,
// transition scrim, skip link. Every route renders through this layout.
import "../styles/tokens.css";
import "../styles/base.css";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { withBase } from "../lib/url";
import {
  absoluteUrl,
  OG_ALT,
  OG_DEFAULT_PATH,
  OG_HEIGHT,
  OG_WIDTH,
} from "../lib/seo";

interface Props {
  /** Complete document title — compose it with the `lib/seo` formatters
   * (`homeTitle`/`pdpTitle`/`pageTitle`), never inline (RFC-001 C4). */
  title: string;
  description?: string;
  /** `article` for journal posts; `website` everywhere else. */
  ogType?: "website" | "article";
  /** BASE_URL-relative OG image path; defaults to the house placeholder. */
  ogImage?: string;
  /** Error/utility routes keep themselves out of the index. */
  noindex?: boolean;
}

const {
  title,
  description = "osvant — eau de parfum, est. batch 001.",
  ogType = "website",
  ogImage = OG_DEFAULT_PATH,
  noindex = false,
} = Astro.props;

// Canonical + OG absolutes resolve against `site` (astro.config.mjs).
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImageUrl = absoluteUrl(withBase(ogImage), Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-meta-description />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} data-canonical />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /* Sharing (RFC-001 C4). og:image is the house default until the w6
        per-scent composites land (06 §1 ledger, ADR-008). */
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="osvant" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} data-og-title />
    <meta property="og:description" content={description} data-og-description />
    <meta property="og:url" content={canonical} data-og-url />
    <meta property="og:image" content={ogImageUrl} data-og-image />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-twitter-title />
    <meta
      name="twitter:description"
      content={description}
      data-twitter-description
    />
    <meta name="twitter:image" content={ogImageUrl} data-twitter-image />
    {
      /* @font-face + the --font--mosvita stack, plus preload links for the
        filtered cuts. Display first: the LCP element on most routes is an
        impact headline (01 §3.3). SemiBold is left to swap — eyebrows set at
        0.625rem and the metric-matched fallback covers them (ADR-014). */
    }
    <Font
      cssVariable="--font--mosvita"
      preload={[{ weight: 900 }, { weight: 400 }]}
    />
    <title>{title}</title>

    {/* Per-page head extras — Product JSON-LD on PDPs (RFC-001 C4). */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Preloader (M §6) — core/preloader.ts drives it, gated on
         sessionStorage so it only ever shows once per browser session. -->
    <div data-preloader>
      <p class="preloader__label">decanting…</p>
      <p class="preloader__count" data-preloader-count>0%</p>
    </div>

    <Nav />

    <main id="main" data-taxi>
      <div data-taxi-view data-module="nav-theme">
        <slot />
      </div>
    </main>

    <Footer />

    <!-- Cart drawer — global overlay chrome (03 cart drawer), mounted
         once at boot; lives outside [data-taxi] like the footer. -->
    <CartDrawer />

    <!-- Rive `page-transition` placeholder scrim (RFC B4.2) — styled and
         driven by core/transition.ts; declared here, outside [data-taxi],
         per 01-arch §7 ("layouts: ... transition scrim"). -->
    <div data-transition-scrim></div>

    <!-- Landscape prompt (03 §7, 01 §5.7) — pure CSS gate: shows only on
         mobile landscape (height < 480px). Rive `mob-landscape` artboard
         lands with the asset batch (06 §1); placeholder card until then.
         Copy is unstated in LAW docs — flagged as a gap. -->
    <div class="landscape-prompt" role="status">
      <p class="landscape-prompt__mark display" aria-hidden="true">osvant</p>
      <p class="landscape-prompt__copy">rotate your phone</p>
    </div>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 1000;
    padding: 0.75rem 1.25rem;
    background: var(--color--phosphor);
    color: var(--color--black);
    text-decoration: none;
    border-radius: var(--radius--xs);
  }

  .skip-link:focus {
    top: 1rem;
  }

  [data-preloader] {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--color--black);
    color: var(--color--white);
  }

  .preloader__label {
    font-size: var(--text--h5);
    margin: 0;
  }

  .preloader__count {
    font-size: var(--text--eyebrow);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  /* Landscape prompt (03 §7) — only on mobile landscape */
  .landscape-prompt {
    display: none;
  }

  @media (orientation: landscape) and (height <= 480px) {
    .landscape-prompt {
      position: fixed;
      inset: 0;
      z-index: 3000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--color--ink-1);
      color: var(--color--white);
    }

    .landscape-prompt__mark {
      margin: 0;
      color: var(--color--phosphor);
    }

    .landscape-prompt__copy {
      margin: 0;
      font-size: var(--text--h6);
    }
  }
</style>
