{
  "name": "osvant",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "typecheck": "astro check",
    "test": "vitest run",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "size": "node scripts/check-size.mjs",
    "lhci": "lhci autorun",
    "check:assets": "node scripts/check-assets.mjs",
    "stills": "node scripts/prepare-stills.mjs"
  },
  "size-limit": [
    {
      "name": "core+transitions JS (M §10 / 04-qa §4)",
      "path": "dist/**/*.js",
      "limit": "350 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@unseenco/taxi": "^1.9.1",
    "astro": "^7.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "size-limit": "^12.1.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
