# OSVANT environment config (05-cicd-environments.md §1). A static build
# holds no secrets — every value below is PUBLIC_ and ships in the bundle.

# Canonical site URL for the environment being built.
#   dev:      http://localhost:4321
#   staging:  https://staging.osvant.com
#   prod:     https://osvant.com
PUBLIC_SITE_URL=http://localhost:4321

# /dev harnesses (guide task 1.9, 06-assets §2): staging/preview only,
# never production. Always on in `astro dev` regardless of this flag.
PUBLIC_DEV_HARNESS=false
